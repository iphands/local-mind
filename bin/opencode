#!/bin/bash
set -e
ROOT=`git rev-parse --show-toplevel`

# Container runtime: docker if present, else podman (override with CONTAINER_RUNTIME)
CRT=${CONTAINER_RUNTIME:-$(command -v docker >/dev/null 2>&1 && echo docker || echo podman)}

${ROOT}/bin/build-container-opencode || {
  echo "BUILD FAILED"
  exit 1
}

cd "${ROOT}/opencode"

# -v /home/iphands/prog/ai/opencode/opencode_data:/home/iphands/.opencode:rw
# -e OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=16000

CONTAINER_ARGS=(
  --name opencode
  --user 1000:1000
  -e HOSTNAME=opencode
  -p 0.0.0.0:8080:8080
  -v ${ROOT}/opencode/container_data/config:/home/iphands/.config:rw
  -v ${ROOT}/opencode/container_data/cache:/home/iphands/.cache:rw
  -v ${ROOT}/opencode/container_data/local:/home/iphands/.local:rw
  -v ${ROOT}/opencode/container_data/.bash_history:/home/iphands/.bash_history:rw
  -v ${HOME}/prog:/home/iphands/prog:rw
  -v ${HOME}/.gitignore:/home/iphands/.gitignore:ro
  -v ${HOME}/.claude/skills:/home/iphands/.claude/skills:ro
  -v ${ROOT}/opencode/container_data/claude_transcripts:/home/iphands/.claude/transcripts:rw

  --device /dev/dri
  -e DISPLAY=$DISPLAY
  -e XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR
  -e WAYLAND_DISPLAY=$WAYLAND_DISPLAY
  -v $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY
)

# Optional host mounts: only if the source exists (podman errors on missing paths)
for m in \
  /mnt/noir/scratch:/mnt/noir/scratch:ro \
  /mnt/noir/scratch/ai:/ai:ro \
  /mnt/noir/scratch/ai/data/scratch:/scratch:rw \
  /mnt/noir/scratch/relocate:/mnt/noir/scratch/relocate:rw \
  /mnt/noir/scratch/ai/vllm:/mnt/noir/scratch/ai/vllm:rw
do
  [ -e "${m%%:*}" ] && CONTAINER_ARGS+=(-v "$m")
done

if [ "$CRT" = docker ]; then
  CONTAINER_ARGS+=(-v /run/docker.sock:/var/run/docker.sock:rw --gpus all)
else
  # rootless podman: keep host uid mapping, skip SELinux relabel issues
  CONTAINER_ARGS+=(--userns=keep-id --security-opt label=disable)
  PSOCK=${XDG_RUNTIME_DIR}/podman/podman.sock
  [ -S "$PSOCK" ] && CONTAINER_ARGS+=(-v "$PSOCK:/var/run/docker.sock:rw")
fi

${CRT} run --rm -it "${CONTAINER_ARGS[@]}" ocli
