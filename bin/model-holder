#!/bin/bash
set -e
pushd ./model-holder >/dev/null
cargo build --release
popd >/dev/null

# Resolve all path arguments to absolute paths before cd'ing
resolved_args=()
for arg in "$@"; do
    # Check if this looks like a file path (not a flag)
    if [[ "$arg" != -* ]] && [[ -e "$arg" || "$arg" == *"/"* || "$arg" == *".gguf" || "$arg" == *".ggml" || "$arg" == *".bin" ]]; then
        # Try to resolve it (realpath handles relative paths, symlinks, and glob patterns)
        if resolved=$(realpath -m "$arg" 2>/dev/null); then
            resolved_args+=("$resolved")
        else
            # If realpath fails, just pass it through
            resolved_args+=("$arg")
        fi
    else
        # Pass flags and other args through unchanged
        resolved_args+=("$arg")
    fi
done

pushd ./model-holder >/dev/null
./target/release/model-holder "${resolved_args[@]}"
popd >/dev/null