#!/bin/bash
# Builds opencode/helpers/model-switcher and runs it against opencode 2's config
# (opencode/container_data/config/opencode). Works from any cwd.
set -e
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cargo build --release --quiet --manifest-path "$ROOT/opencode/helpers/model-switcher/Cargo.toml"
cd "$ROOT/opencode"
exec ./helpers/model-switcher/target/release/model-switcher "$@"
