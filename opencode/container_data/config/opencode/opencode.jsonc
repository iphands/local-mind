{
  "model": "cosmo-proxy/cosmo-proxy",
  "plugin": ["oh-my-opencode@latest"],
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "local-mind",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git reset *": "ask",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "git push --force *": "deny",
      "git branch -D *": "deny"
    }
  },
  "provider": {
    "runpod": {
      "name": "runpod",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "runpod-model": { "name": "runpod-model" }, },
      "options": {
        "baseURL": "https://9haoyv9i0buu4y-7860.proxy.runpod.net/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "cosmo-00": {
      "name": "cosmo-00",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "cosmo-rtx-pro-6000": { "name": "cosmo-rtx-pro-6000" }, },
      "options": {
        "baseURL": "http://cosmo.lan:8700/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "cosmo-01": {
      "name": "cosmo-01",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "cosmo-4060": { "name": "cosmo-4060" }, },
      "options": {
        "baseURL": "http://cosmo.lan:8701/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "cosmo-proxy": {
      "name": "cosmo-proxy",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "cosmo-proxy": { "name": "cosmo-proxy" }, },
      "options": {
        "baseURL": "http://cosmo.lan:8799/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "noir-llama": {
      "name": "noir-llama",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "noir-model": { "name": "noir-model" }, },
      "options": {
        "baseURL": "http://noir.lan:8799/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "station-llama": {
      "name": "station-llama",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "station-model": { "name": "station-model" }, },
      "options": {
        "baseURL": "http://station.lan:8799/v1",
        "apiKey": "deadbeef1234"
      }
    },
  }
}
