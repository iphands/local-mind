{
  "$schema": "https://opencode.ai/config.json",
  "model": "cosmo-proxy/cosmo-proxy",
  "lsp": true,
  "mcp": {
    "docs-rs": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@nuskey8/docs-rs-mcp@latest"]
    }
  },
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "default_agent": "local-mind",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git reset *": "ask",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "git push --force *": "deny",
      "git branch -D *": "deny"
    }
  },
  "provider": {
    "runpod": {
      "name": "runpod",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "runpod-model": { "name": "runpod-model" }, },
      "options": {
        "baseURL": "https://9haoyv9i0buu4y-7860.proxy.runpod.net/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "cosmo-00": {
      "name": "cosmo-00",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "cosmo-6000": { "name": "cosmo-6000", "limit": { "context": 262144, "output": 262144, "input": 199229 } } },
      "options": {
        "baseURL": "http://cosmo.lan:8700/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "cosmo-01": {
      "name": "cosmo-01",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "cosmo-4060": { "name": "cosmo-4060", "limit": { "context": 262144, "output": 262144, "input": 199229 } } },
      "options": {
        "baseURL": "http://cosmo.lan:8701/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "cosmo-proxy": {
      "name": "cosmo-proxy",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "cosmo-proxy": { "name": "cosmo-proxy", "limit": { "context": 262144, "output": 262144, "input": 199229 } },
        "cosmo-heavy": { "name": "cosmo-heavy", "limit": { "context": 262144, "output": 262144, "input": 199229 } },
        "cosmo-light": { "name": "cosmo-light", "limit": { "context": 262144, "output": 262144, "input": 199229 } }
      },
      "options": {
        "baseURL": "http://cosmo.lan:8799/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "noir-llama": {
      "name": "noir-llama",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "noir-model": { "name": "noir-model", "limit": { "context": 262144, "output": 32768, "input": 199229 } }, },
      "options": {
        "baseURL": "http://noir.lan:8799/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "station-llama": {
      "name": "station-llama",
      "npm": "@ai-sdk/openai-compatible",
      "models": { "station-model": { "name": "station-model", "limit": { "context": 262144, "output": 32768, "input": 199229 } }, },
      "options": {
        "baseURL": "http://station.lan:8799/v1",
        "apiKey": "deadbeef1234"
      }
    },
    "llama-api": {
      "name": "llama-api",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "Llama-3.3-70B-Instruct": { "name": "Llama-3.3-70B-Instruct", "limit": { "context": 131072, "output": 32768, "input": 199229 } },
        "Llama-3.3-8B-Instruct": { "name": "Llama-3.3-8B-Instruct", "limit": { "context": 131072, "output": 32768, "input": 199229 } },
        "Llama-4-Maverick-17B-128E-Instruct-FP8": { "name": "Llama-4-Maverick-17B-128E-Instruct-FP8", "limit": { "context": 131072, "output": 32768, "input": 199229 } },
        "Llama-4-Scout-17B-16E-Instruct-FP8": { "name": "Llama-4-Scout-17B-16E-Instruct-FP8", "limit": { "context": 131072, "output": 32768, "input": 199229 } }
      },
      "options": {
        "baseURL": "https://api.llama.com/compat/v1/",
        "apiKey": "LLM|1343444514383814|I02HNL1d2uBTzFM3rG_04HLu5nI"
      }
    }
  }
}
