# basalt pins — plain KEY=value only (project gate 1c): `source`d by lib/common.sh and passed to
# `docker build --build-arg`, so no quotes, no spaces, no trailing comments.
# Changing any pin is a plan (context/plans/RULES.md § When Does a Change Need a Plan?).

# Basalt: main on 2026-11-04 (owner decision, Plan 01) — v0.2.1 (1b3f6964) plus three serve/ + docs
# commits; the engine is identical to v0.2.1.
BASALT_REPO=https://github.com/jesdga95/basalt.git
BASALT_SHA=dc047a77beeddf1e91234d983a91d6bf929e9619

# CUDA 13.4.3 on Ubuntu 24.04, tag AND manifest-list digest — the same pins ../ninfer built with;
# both tags re-resolved to these digests with `docker buildx imagetools inspect` on 2026-11-04.
CUDA_DEVEL_IMAGE=nvidia/cuda:13.4.3-devel-ubuntu24.04@sha256:5626a7d0ecafe3e7c115a452f6b05f20f214f8509346196a7835b205dc5b7fd9
CUDA_RUNTIME_IMAGE=nvidia/cuda:13.4.3-runtime-ubuntu24.04@sha256:f58bd7a0701fae3a2160f22e1d451b77b349bd9ef83dad76f5529aa413c149a8

# Our image's repository; ./build tags it cu<cuda digits>-sm120-<sha7>.
IMAGE=iphands/basalt-blackwell
