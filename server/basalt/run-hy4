#!/usr/bin/env bash
# Serve a Hy4-flash Basalt pack on :8700: ./run-hy4 [PACK.basalt]
#
#   ./run-hy4               1 slot, 362144 tokens
#   DRY_RUN=1 ./run-hy4 …   every check, then print the docker command; starts and creates nothing
#
# Hy4-flash is not Flash-Next, and ./run's flags do not fit it: it has no --ple-io (its 63 GB Engram
# n-gram table is always read from the pack, 64 rows per prompt token, never held in RAM), its KV
# formats are fp16 and fp8, and upstream lists no parallel slots for it. Flash-Next packs: ./run.
#
# Knobs (env)        default                                    Basalt setting
#   PACK / $1        /mnt/noir/…/vllm/jesdga/Hy4-flash-NVFP4.basalt   serve <pack> (its dir mounted :ro at /models)
#                    (the NFS copy; a local one: PACK=models.local/<pack> ./run-hy4)
#   MAX_CONTEXT      362144                                     --max-context (1024..1048576)
#   KV               fp16                                       --kv   (fp16 | fp8); fp8 rows are about 0.6× the size
#   PARALLEL         1                                          --parallel (1..8); above 1 is unproven for this model
#   SLOT_FULL_CONTEXT 1 (only when PARALLEL > 1)                --slot-full-context (each slot gets MAX_CONTEXT)
#   VISION           dynamic                                    --vision   (off | dynamic); no video
#   PORT             8700                                       --port, and -p 0.0.0.0:$PORT:$PORT
#   ALIAS            cosmo-6000                                 --alias   (the one name requests must use)
#   ALLOWED_HOSTS    "cosmo.lan <hostname>"                     --allowed-host, one per name (Host-header check)
#   API_KEY          empty (none; Basalt warns)                 --api-key   (printed as REDACTED)
#   NAME             basalt                                     docker --name
#   CACHE_DIR        storage/cache                              mounted at ~/.cache (Basalt's ~/.cache/basalt/)
#   EXTRA_ARGS       empty                                      appended LAST to the serve flags (last wins)
#   IMAGE_OVERRIDE   empty = the newest image built for BASALT_SHA
#
# Defaults are starting values (Plan 11, 2026-11-20): ./run's context and port, upstream's KV default.
# Not measured, and not yet the owner's choices.
#
# The docker half of this file repeats ./run's on purpose (Plan 11 § Why a second launcher): change
# the container shape in one and change it in the other.
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR source=lib/common.sh
source "$HERE/lib/common.sh"
load_pins

usage() { sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "${BASH_SOURCE[0]}"; exit 0; }

# ------------------------------------------------------------- arguments

pack_arg=
for a in "$@"; do
  case $a in
    -h|--help) usage ;;
    -*) die "unknown option '$a' (./run-hy4 --help)." ;;
    *) [[ -z $pack_arg ]] || die "one pack only, got '$pack_arg' and '$a'."
       pack_arg=$a ;;
  esac
done

DRY_RUN=${DRY_RUN:-0}
PACK=${pack_arg:-${PACK:-/mnt/noir/scratch/ai/llm/models/vllm/jesdga/Hy4-flash-NVFP4.basalt}}
MAX_CONTEXT=${MAX_CONTEXT:-362144}
KV=${KV:-fp16}
PARALLEL=${PARALLEL:-1}
SLOT_FULL_CONTEXT=${SLOT_FULL_CONTEXT:-1}
VISION=${VISION:-dynamic}
PORT=${PORT:-8700}
ALIAS=${ALIAS:-cosmo-6000}
ALLOWED_HOSTS=${ALLOWED_HOSTS-"cosmo.lan $(hostname)"}
API_KEY=${API_KEY:-}
NAME=${NAME:-basalt}
CACHE_DIR=${CACHE_DIR:-$HERE/storage/cache}
EXTRA_ARGS=${EXTRA_ARGS:-}

# The engine checks the context range only once it loads; the bounds are its own
# (context_policy.hpp's kMinContext, and the pack's context_length).
if ! [[ $MAX_CONTEXT =~ ^[1-9][0-9]*$ ]] || (( MAX_CONTEXT < 1024 || MAX_CONTEXT > 1048576 )); then
  die "MAX_CONTEXT must be 1024..1048576 for Hy4-flash, got '$MAX_CONTEXT'."
fi
[[ $KV == fp16 || $KV == fp8 ]] || die "KV must be fp16 or fp8 for Hy4-flash, got '$KV'." \
                                       "  int8, q4_0 and k8v4 are Flash-Next's formats (./run)."
[[ $PARALLEL =~ ^[1-8]$ ]] || die "PARALLEL must be 1..8, got '$PARALLEL'."
[[ $SLOT_FULL_CONTEXT =~ ^[01]$ ]] || die "SLOT_FULL_CONTEXT must be 0 or 1, got '$SLOT_FULL_CONTEXT'."
[[ $VISION == off || $VISION == dynamic ]] || die "VISION must be off or dynamic for Hy4-flash, got '$VISION'."
if ! [[ $PORT =~ ^[1-9][0-9]*$ ]] || (( PORT > 65535 )); then die "PORT must be 1..65535, got '$PORT'."; fi
[[ -n $ALIAS ]] || die "ALIAS is empty: every request must name the served model."

# ------------------------------------------------------------------ the pack

case $PACK in
  *.ninfer) die "$PACK is a NInfer artifact; Basalt loads only .basalt packs." \
                "  serve it from ../ninfer instead." ;;
esac
[[ -f $PACK ]] || die "pack not found: $PACK" \
                       "  the default is the NFS copy (is /mnt/noir mounted?); or name another: PACK=<path> ./run-hy4"
[[ -r $PACK ]] || die "pack not readable: $PACK"
magic=$(LC_ALL=C head -c 8 -- "$PACK" | tr -d '\0')
[[ $magic == BASALTMF ]] || die "$PACK is not a .basalt pack (first bytes '$magic', want 'BASALTMF')."
# Engine flags are per model: refuse another model's pack here, by name, not at the engine.
arch=$(pack_arch "$PACK")
case $arch in
  hy4flash|hy_v4_flash) ;;
  qwen4exp) die "$PACK is a Flash-Next pack (architecture qwen4exp)." \
                "  serve it with ./run instead." ;;
  *) die "$PACK is not a Hy4-flash pack (architecture '${arch:-unreadable}', want hy4flash)." \
         "  ./run-hy4 passes Hy4-flash's flags only." ;;
esac
pack_real=$(realpath -e -- "$PACK")
pack_dir=$(dirname -- "$pack_real")
pack_file=$(basename -- "$pack_real")
pack_bytes=$(stat -c '%s' -- "$pack_real")
pack_fs=$(stat -f -c '%T' -- "$pack_real")

# --------------------------------------------------------------- host checks

if [[ $DRY_RUN == 1 ]]; then
  # report, don't refuse: the dry run is a gate step, and vLLM on :8700 is the daily driver
  ( refuse_busy "$PORT" vllm ninfer ignis "$NAME" ) || echo "== (DRY_RUN) a real run would refuse: :$PORT or the GPU is busy"
else
  refuse_busy "$PORT" vllm ninfer ignis "$NAME"
fi

RUN_IMAGE=${IMAGE_OVERRIDE:-$(image_for_pin)}
[[ -n $RUN_IMAGE ]] || die "no $IMAGE image is labelled ai.basalt.ref=$BASALT_SHA; run ./build first."

ensure_dir "$CACHE_DIR"

# ------------------------------------------------------------- the command

serve_args=(
  serve "/models/$pack_file"
  --host 0.0.0.0 --port "$PORT"
  --alias "$ALIAS"
)
read -r -a hosts <<<"$ALLOWED_HOSTS"
for h in "${hosts[@]}"; do serve_args+=(--allowed-host "$h"); done
serve_args+=(
  --gpu 0
  --max-context "$MAX_CONTEXT"
  --kv "$KV"
  --parallel "$PARALLEL"
)
slots="1 slot × $MAX_CONTEXT"
if (( PARALLEL > 1 )); then
  if [[ $SLOT_FULL_CONTEXT == 1 ]]; then
    serve_args+=(--slot-full-context)
    slots="$PARALLEL slots × $MAX_CONTEXT (slot-full-context)"
  else
    slots="$PARALLEL slots × $(( MAX_CONTEXT / PARALLEL )) (shared)"
  fi
fi
serve_args+=(--vision "$VISION")
[[ -n $API_KEY ]] && serve_args+=(--api-key "$API_KEY")
read -r -a extra <<<"$EXTRA_ARGS"
serve_args+=("${extra[@]}")

docker_args=(
  run --rm --name "$NAME"
  --user "$RUN_UID:$RUN_GID"
  -e HOME=/home/ubuntu
  --gpus device=0                                  # the RTX PRO 6000 only, never the 4060
  -p "0.0.0.0:$PORT:$PORT"
  --ulimit memlock=-1                              # the RAM tier's experts are page-locked
  -v "$pack_dir:/models:ro"
  -v "$CACHE_DIR:/home/ubuntu/.cache:rw"
  "$RUN_IMAGE"
)

# the printed copy hides the api key
shown=()
mask=0
for w in "${DOCKER[@]}" "${docker_args[@]}" "${serve_args[@]}"; do
  if (( mask )); then shown+=(REDACTED); mask=0; continue; fi
  [[ $w == --api-key ]] && mask=1
  shown+=("$w")
done

echo "== image: $RUN_IMAGE"
echo "== pack:  $pack_real ($pack_bytes bytes, $(( pack_bytes / 1073741824 )) GiB)"
echo "== mode:  $slots, kv=$KV, vision=$VISION, http://0.0.0.0:$PORT/v1 as '$ALIAS'"
echo "== cache: $CACHE_DIR"
if [[ $pack_fs == nfs* ]]; then
  # The reader Flash-Next's --ple-io direct uses; that mode stalled a long cold prompt from this NFS
  # (README § Prerequisites). Hy4-flash has no other mode, so say it before the first prompt does.
  echo "== note:  the pack is on $pack_fs, and Hy4-flash reads its Engram table from the pack for every prompt"
  echo "==        token (64 random 4 KiB reads, no RAM mode): a long cold prompt may stall there."
  echo "==        A local copy avoids it: PACK=models.local/$pack_file ./run-hy4"
fi
printf '%q ' "${shown[@]}"
echo

if [[ $DRY_RUN == 1 ]]; then
  echo "== (DRY_RUN) nothing started"
  exit 0
fi
exec "${DOCKER[@]}" "${docker_args[@]}" "${serve_args[@]}"
