# BuildKit reads <Dockerfile>.dockerignore beside the Dockerfile, in preference to the context's own
# .dockerignore (vendor/basalt has one since 0.3.3). Mirrors upstream's .gitignore (build output,
# local packs).
.git
build*/
bin/
pack/
packs/
mtp/
models/
logs/
.venv/
.ccache/
**/__pycache__/
**/*.pyc
