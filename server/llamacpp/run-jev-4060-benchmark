#!/bin/bash
# Benchmark the jev decision server (H2O Lightning 4B on the RTX 4060) across slot / KV / ubatch
# settings, with request shapes that mirror the jev OpenCode plugin (see jev-bench-load.py).
#
#   ./run-jev-4060-benchmark            full matrix (9 configs, ~35 min)
#   ./run-jev-4060-benchmark --quick    configs #1 and #5, phases at a third of the length (~6 min)
#   MATRIX="1:0:512:40960 4:1:512:40960" ./run-jev-4060-benchmark
#
# A config is NP:KV_UNIFIED:UB:CTX. Each one is started through ./run-jev-4060 (DETACH=1, so no
# docker pull) as container llama-jev-bench on port 8702, measured, and stopped.
#
# The 4060 has 8 GiB and production uses 6.7, so this refuses to run while llama-server-4060 is up.
# Stop it first, and start it again with ./run-jev-4060 when the benchmark is done.
#
# Results: bench-results/jev-<date>-<time>/ (cfg-NN.json, server-NN.log, metrics-NN.txt, summary.md)
set -ue

cd "$(dirname "$(realpath "$0")")"

PROD_NAME=llama-server-4060
NAME=llama-jev-bench
PORT=8702
GPU=1                  # nvidia-smi index of the 4060 (the launcher's device=1)
START_TIMEOUT=180
FREE_MIB=1024          # GPU counts as free below this

DEFAULT_MATRIX="1:0:512:40960 2:0:512:40960 2:1:512:40960 4:0:512:40960 4:1:512:40960 4:1:1024:40960 6:1:512:40960 8:1:512:40960 4:1:512:65536"
SCALE=1.0
if [[ "${1:-}" == "--quick" ]]; then
  DEFAULT_MATRIX="1:0:512:40960 4:1:512:40960"
  SCALE=0.33
elif [[ -n "${1:-}" ]]; then
  echo "usage: $0 [--quick]   (MATRIX=\"NP:KVU:UB:CTX ...\" overrides the configs)"; exit 2
fi
MATRIX=${MATRIX:-$DEFAULT_MATRIX}

vram_used() { nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits -i "$GPU" | tr -d ' '; }

# ---------------------------------------------------------------- preflight
if [[ -n "$(docker ps -q -f "name=^${PROD_NAME}$")" ]]; then
  echo "[FATAL] $PROD_NAME is running. Stop it first (the benchmark needs the whole 4060),"
  echo "        then start it again with ./run-jev-4060 when the benchmark ends."
  exit 1
fi
if [[ -n "$(docker ps -aq -f "name=^${NAME}$")" ]]; then
  echo "[FATAL] a $NAME container already exists (docker stop $NAME)"; exit 1
fi
command -v python3 >/dev/null || { echo "[FATAL] python3 not found"; exit 1; }
used=$(vram_used)
(( used < FREE_MIB )) || { echo "[FATAL] GPU $GPU already uses $used MiB; something else is on the 4060"; exit 1; }

OUT=bench-results/jev-$(date +%Y%m%d-%H%M%S)
mkdir -p "$OUT"
SAMPLER=

cleanup() {
  [[ -n "$SAMPLER" ]] && kill "$SAMPLER" 2>/dev/null || true
  if [[ -n "$(docker ps -aq -f "name=^${NAME}$")" ]]; then docker stop "$NAME" >/dev/null 2>&1 || true; fi
}
trap cleanup EXIT
trap 'echo; echo "[ABORT] stopping $NAME"; exit 130' INT TERM

wait_gpu_free() {
  # docker stop returns before --rm has removed the container; the next launch needs the name
  for _ in $(seq 1 60); do [[ -z "$(docker ps -aq -f "name=^${NAME}$")" ]] && break; sleep 1; done
  for _ in $(seq 1 60); do (( $(vram_used) < FREE_MIB )) && return 0; sleep 1; done
  echo "[WARN] GPU $GPU still at $(vram_used) MiB after 60 s"
}

record_failure() {  # $1 idx, $2 config, $3 reason
  python3 -I -c 'import json,sys; json.dump({"config": sys.argv[2], "failed": sys.argv[3]}, open(sys.argv[1], "w"))' \
    "$OUT/cfg-$1.json" "$2" "$3"
}

echo "## jev benchmark -> $OUT"
echo "## configs (NP:KVU:UB:CTX): $MATRIX"
echo "## scale: $SCALE"
i=0
for cfg in $MATRIX; do
  i=$((i + 1)); idx=$(printf '%02d' "$i")
  IFS=: read -r np kvu ub ctx <<<"$cfg"
  echo
  echo "=== [$idx] NP=$np KV_UNIFIED=$kvu UB=$ub CTX=$ctx"

  if ! DETACH=1 METRICS=1 NAME="$NAME" PORT="$PORT" PARALLEL="$np" KV_UNIFIED="$kvu" UB="$ub" CTX="$ctx" \
      ./run-jev-4060 >"$OUT/launch-$idx.txt" 2>&1; then
    echo "  launch failed: $(tail -1 "$OUT/launch-$idx.txt")"
    record_failure "$idx" "$cfg" "launch failed"
    continue
  fi

  # Sample VRAM from the start, so load-time peaks count
  ( peak=0; while :; do v=$(vram_used); (( v > peak )) && { peak=$v; echo "$peak" >"$OUT/vram-$idx.txt"; }; sleep 0.5; done ) &
  SAMPLER=$!

  ready=0
  for _ in $(seq 1 "$START_TIMEOUT"); do
    if [[ -z "$(docker ps -q -f "name=^${NAME}$")" ]]; then break; fi
    if [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 2 "http://127.0.0.1:$PORT/health")" == 200 ]]; then ready=1; break; fi
    sleep 1
  done
  if (( ! ready )); then
    docker logs "$NAME" >"$OUT/server-$idx.log" 2>&1 || true
    reason=$(grep -m1 -i -E 'out of memory|failed|error' "$OUT/server-$idx.log" | cut -c1-160 || true)
    echo "  failed to start: ${reason:-not healthy after ${START_TIMEOUT}s}"
    record_failure "$idx" "$cfg" "${reason:-not healthy after ${START_TIMEOUT}s}"
    kill "$SAMPLER" 2>/dev/null || true; SAMPLER=
    cleanup; wait_gpu_free
    continue
  fi
  echo "  ready; running load"

  python3 -I jev-bench-load.py run --url "http://127.0.0.1:$PORT" --config "$cfg" --scale "$SCALE" \
    --out "$OUT/cfg-$idx.json" || echo "  [WARN] load generator exited non-zero"

  curl -s -m 5 "http://127.0.0.1:$PORT/metrics" >"$OUT/metrics-$idx.txt" || true
  docker logs "$NAME" >"$OUT/server-$idx.log" 2>&1 || true
  kill "$SAMPLER" 2>/dev/null || true; SAMPLER=
  peak=$(cat "$OUT/vram-$idx.txt" 2>/dev/null || echo "")
  if [[ -f "$OUT/cfg-$idx.json" ]]; then
    python3 -I -c 'import json,sys; p=sys.argv[1]; d=json.load(open(p)); d["vram_peak_mib"]=int(sys.argv[2]) if sys.argv[2] else None; json.dump(d, open(p, "w"), indent=1)' \
      "$OUT/cfg-$idx.json" "$peak"
  else
    record_failure "$idx" "$cfg" "load generator wrote no result"
  fi
  echo "  VRAM peak: ${peak:-?} MiB"

  docker stop "$NAME" >/dev/null 2>&1 || true
  wait_gpu_free
done

echo
python3 -I jev-bench-load.py summarize "$OUT"
echo "Results in $OUT. Start production again with ./run-jev-4060"
