#!/usr/bin/env bash
# What is fastest for Qwen3.5-122B-A10B-NVFP4 at the concurrency it actually serves?
#
#   ./scripts/qwen-conc-sweep                    # the whole matrix (11 boots)
#   ONLY=base,moe-b12x ./scripts/qwen-conc-sweep # just those configs
#   CTX=3072 CONC=1,2,4 GEN=1024 ./scripts/qwen-conc-sweep
#
# One prompt size (3k tokens), three concurrencies (1/2/4), and for each: decode
# tok/s per-stream and aggregate, plus TTFT cold and warm. Two things about this
# model drive the config matrix:
#
#   * It is a 256-expert MoE with 8 active per token (moe_intermediate_size 1024,
#     48 layers). The MoE kernel is the dominant lever, and the old bench-wrapper
#     matrix never touched it -- that swept the NVFP4 *linear* backend and MTP only.
#   * MTP speculation trades against concurrency: a draft that pays for itself at
#     batch 1 is wasted work once the batch already saturates the GPU. So MTP is
#     crossed with concurrency here rather than measured at batch 1 alone.
#
# MAX_NUM_SEQS is forced to 8. qwen/run ships 3, which would silently queue the
# 4th request of a concurrency-4 measurement -- the result would then describe that
# cap rather than the hardware.
#
# Reports BOTH per-stream decode (what one user feels) and aggregate decode (what
# the box delivers): they diverge as concurrency rises, and quoting one hides the
# trade. TTFT is reported cold and warm because prefix caching makes a repeated
# prompt skip prefill entirely, and real agentic traffic is nearly all warm. The
# cold number is where prefill tok/s comes from.
set -uo pipefail   # NOT -e: survive a failing config and keep going

HERE=$(cd "$(dirname "$0")/.." && pwd)
MODEL=${MODEL:-Qwen3.5-122B-A10B-NVFP4}
NAME=vllm
PORT=${PORT:-8700}
HOST="localhost:${PORT}"
APIMODEL=${APIMODEL:-cosmo-6000}
READY_TIMEOUT=${READY_TIMEOUT:-2400}   # 76GB of weights over NFS; be patient
CTX=${CTX:-3072}                       # every prompt is this size
GEN=${GEN:-1024}                       # generation length, ignore_eos so it is exact
CONC=${CONC:-1,2,4}
REPEATS=${REPEATS:-2}                  # measured warm passes per point (median)
LOGDIR=${LOGDIR:-$HERE/bench/bench-logs}
RESULTS=${RESULTS:-$HERE/bench/qwen-conc-results.md}
JSONL=${JSONL:-$HERE/bench/qwen-conc-results.jsonl}
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"; [[ -n "${LOGS_PID:-}" ]] && kill "$LOGS_PID" 2>/dev/null' EXIT

# shellcheck source-path=SCRIPTDIR source=../bench/_bench-lib.sh
source "$HERE/bench/_bench-lib.sh"
mkdir -p "$LOGDIR"
for tool in curl jq docker bc; do
  command -v "$tool" >/dev/null || { echo "## need $tool"; exit 2; }
done

# label | env assignments passed through to qwen/run
# A: speculation   B: MoE backend   C: NVFP4 linear   D: shape knobs
# E (best-combo) is appended via EXTRA_CONFIGS once A-D have reported.
CONFIGS=(
  "base|SPEC_TOKENS=2"
  "mtp0|SPEC_TOKENS=0"
  "mtp3|SPEC_TOKENS=3"
  "moe-trtllm|SPEC_TOKENS=2|MOE_BACKEND=flashinfer_trtllm"
  "moe-b12x|SPEC_TOKENS=2|MOE_BACKEND=flashinfer_b12x"
  "moe-cutlass|SPEC_TOKENS=2|MOE_BACKEND=flashinfer_cutlass"
  "lin-cudnn|SPEC_TOKENS=2|NVFP4_BACKEND=flashinfer_cudnn"
  "lin-b12x|SPEC_TOKENS=2|NVFP4_BACKEND=flashinfer_b12x"
  "cudagraph-full|SPEC_TOKENS=2|CUDAGRAPH_MODE=FULL_AND_PIECEWISE"
  "batched32k|SPEC_TOKENS=2|MAX_BATCHED_TOKENS=32768"
)
[[ -n "${EXTRA_CONFIGS:-}" ]] && while IFS= read -r l; do
  [[ -n "$l" ]] && CONFIGS+=("$l")
done <<<"$EXTRA_CONFIGS"

build_corpus() {
  : > "$WORK/corpus.txt"
  for f in README.md muse/run container/Dockerfile qwen/run common/_run-lib.sh \
           muse/patches/muse-embed-norm/sitecustomize.py \
           scripts/muse-longctx-sweep bench/lib/benchclient.py; do
    [[ -f "$HERE/$f" ]] && { echo "===== $f ====="; cat "$HERE/$f"; } >> "$WORK/corpus.txt"
  done
  while (( $(wc -c < "$WORK/corpus.txt") < $(( CTX * 8 )) )); do
    cat "$WORK/corpus.txt" "$WORK/corpus.txt" > "$WORK/c2" && mv "$WORK/c2" "$WORK/corpus.txt"
  done
}

# Build the request body ONCE to a file -- it keeps jq off the critical path while
# timing concurrent requests. $1 makes the prompt unique when we want a genuine
# prefix-cache MISS; omit it for the canonical warm prompt.
#
# The buster goes at the FRONT, and that placement is the whole point: vLLM caches
# by PREFIX, so a unique suffix after a shared body still hits cache for everything
# but the last few tokens. Measured on the 27B: with the buster appended, three
# supposedly-cold prompts read 829/511/513ms -- only the first was really cold, and
# "cold" TTFT collapsed onto warm. With it prepended: 843/849/845ms, cold every
# time, against 516ms warm.
prompt_for() {  # [cache-buster]
  : > "$WORK/p.txt"
  [[ -n "${1:-}" ]] && printf '%s\n\n' "$1" >> "$WORK/p.txt"
  head -c $(( CTX * 4 )) "$WORK/corpus.txt" >> "$WORK/p.txt"
  printf '\n\nIn one sentence, what kind of code is above?\n' >> "$WORK/p.txt"
  jq -nc --arg m "$APIMODEL" --rawfile p "$WORK/p.txt" --argjson mt "$GEN" \
    '{model:$m, temperature:0, max_tokens:$mt, stream:true, ignore_eos:true,
      stream_options:{include_usage:true},
      messages:[{role:"user",content:$p}]}' > "$WORK/body.json"
}

# One streamed request. TTFT is time to the first content chunk; decode tok/s is
# everything after it. Non-streaming cannot separate the two.
measure() {  # <slot> -> "<ttft_ms> <decode_tps> <total_ms> <ptok> <ctok>"
  local slot=${1:-0} t0 tf t1 line ptok ctok
  local out="$WORK/stream.$slot"
  t0=$(date +%s%N); tf=""
  : > "$out"
  while IFS= read -r line; do
    [[ "$line" == data:* ]] || continue
    [[ -z "$tf" ]] && tf=$(date +%s%N)
    printf '%s\n' "${line#data: }" >> "$out"
  done < <(curl -sSN --max-time 900 -X POST "http://${HOST}/v1/chat/completions" \
             -H 'Content-Type: application/json' --data-binary @"$WORK/body.json")
  t1=$(date +%s%N)
  [[ -z "$tf" ]] && { echo "0 0 0 0 0"; return; }
  ptok=$(grep -o '"prompt_tokens":[0-9]*' "$out" | tail -1 | cut -d: -f2)
  ctok=$(grep -o '"completion_tokens":[0-9]*' "$out" | tail -1 | cut -d: -f2)
  local ttft=$(( (tf - t0) / 1000000 )) total=$(( (t1 - t0) / 1000000 ))
  local dec="0"
  (( total > ttft && ${ctok:-0} > 0 )) && dec=$(echo "scale=1; ${ctok} * 1000 / ($total - $ttft)" | bc)
  echo "$ttft $dec $total ${ptok:-0} ${ctok:-0}"
}

# N identical requests at once ->
#   "<median_ttft> <median_per_stream_decode> <aggregate_decode> <max_total_ms> <ptok>"
measure_conc() {
  local n=$1 i pids=()
  rm -f "$WORK"/m.* "$WORK"/stream.*
  for ((i = 0; i < n; i++)); do measure "$i" > "$WORK/m.$i" & pids+=("$!"); done
  # Wait on THESE pids only: a bare `wait` would also block on the `docker logs -f`
  # follower started at boot, which never exits.
  wait "${pids[@]}" 2>/dev/null
  compgen -G "$WORK/m.*" >/dev/null || { echo "0 0 0 0 0"; return; }
  cat "$WORK"/m.* | awk '
      { t[NR]=$1; d[NR]=$2; agg+=$2; if ($3>mx) mx=$3; if ($4>0) p=$4 }
      END { if (NR==0) { print "0 0 0 0 0"; exit }
            n=asort(t); m=asort(d)
            printf "%d %s %s %d %d\n",
              (n%2 ? t[(n+1)/2] : int((t[n/2]+t[n/2+1])/2)),
              (m%2 ? d[(m+1)/2] : (d[m/2]+d[m/2+1])/2), agg, mx, p+0 }'
  rm -f "$WORK"/m.* "$WORK"/stream.*
}

# median of REPEATS passes, ranked on the given field, carrying the whole row.
# Both cold and warm go through this: measuring cold once and warm as a median is
# how you get a "cold" number that is really single-sample noise -- the first run
# of this sweep reported cold TTFT HIGHER at conc=2 than at conc=4, which is not a
# thing the hardware can do.
med_of() {  # <conc> <sort-field> <fresh-prompt-prefix|"">
  local c=$1 fld=$2 fresh=${3:-} r
  for ((r = 0; r < REPEATS; r++)); do
    # A fresh prefix per repeat keeps every cold pass a genuine prefill; passing
    # "" reuses the canonical prompt, which is the warm/repeat case.
    [[ -n "$fresh" ]] && prompt_for "$fresh-$r"
    measure_conc "$c"
  done | sort -k"$fld" -n | awk '{rows[NR]=$0} END{print rows[int((NR+1)/2)]}'
}

jrec() {
  jq -nc --arg cfg "$1" --argjson conc "$2" --argjson ctt "$3" --argjson wtt "$4" \
        --argjson pf "$5" --argjson dec "$6" --argjson agg "$7" --argjson ptok "$8" \
        --arg model "$MODEL" --arg env "$9" \
    '{config:$cfg, conc:$conc, ttft_cold_ms:$ctt, ttft_warm_ms:$wtt,
      prefill_tps:$pf, decode_per_stream:$dec, decode_agg:$agg,
      prompt_tokens:$ptok, model:$model, env:$env}' >> "$JSONL"
}

build_corpus
IFS=',' read -ra CONCS <<<"$CONC"
echo "## qwen-conc-sweep  model=$MODEL  ctx=$CTX  gen=$GEN  conc=$CONC"
echo "##   MAX_NUM_SEQS forced to 8 (qwen/run ships 3, which would cap conc=4)"
echo "##   configs: ${#CONFIGS[@]}   ~10-15 min each, dominated by the 76GB load"
echo
{ echo; echo "### qwen-conc-sweep  $(date -u '+%Y-%m-%d %H:%M UTC')  model=$MODEL  ctx=$CTX  gen=$GEN"
  echo; echo "| config | conc | TTFT cold (ms) | prefill (tok/s) | TTFT warm (ms) | decode/stream | decode agg |"
  echo "|---|---|---|---|---|---|---|"; } >> "$RESULTS"

for entry in "${CONFIGS[@]}"; do
  label=${entry%%|*}
  envs=${entry#*|}; envs=${envs//|/ }
  [[ -n "${ONLY:-}" && ",$ONLY," != *",$label,"* ]] && continue

  log="$LOGDIR/qwen-conc-$label.log"; : > "$log"
  [[ -n "${LOGS_PID:-}" ]] && kill "$LOGS_PID" 2>/dev/null; LOGS_PID=""
  stop_server
  echo "## [$label] booting  ($envs)"
  boot_t0=$(date +%s)
  # shellcheck disable=SC2086
  env $envs MAX_NUM_SEQS=8 DETACH=1 PORT="$PORT" "$HERE/qwen/run" "$MODEL" >> "$log" 2>&1
  docker logs -f "$NAME" >> "$log" 2>&1 & LOGS_PID=$!
  if ! wait_ready; then
    printf '  %-16s BOOT FAILED -- see %s\n\n' "$label" "$log"
    echo "| $label | BOOT FAILED | | | | | |" >> "$RESULTS"; continue
  fi
  echo "## [$label] ready in $(( $(date +%s) - boot_t0 ))s"

  # First request pays JIT + CUDA-graph capture. Never measured.
  prompt_for "warmup"; measure 0 >/dev/null

  printf '  %-16s %5s %11s %11s %11s %13s %12s\n' \
         "$label" "conc" "ttft_cold" "prefill" "ttft_warm" "dec/stream" "dec_agg"
  for c in "${CONCS[@]}"; do
    # Pay any one-time cost of this batch size before anything is recorded.
    prompt_for "prime-$label-$c"; measure_conc "$c" >/dev/null
    # Cold: every pass gets a prompt this server has never seen, so prefill is
    # really paid. At conc>1 that is N simultaneous cold prefills -- the honest
    # worst case. Median on TTFT (field 1).
    read -r c_ttft _ _ _ ptok < <(med_of "$c" 1 "cold-$label-$c")
    # Warm: the canonical prompt, populated once, then repeated. On this model
    # that is NOT a prefix-cache hit -- Qwen3.5 is hybrid Mamba and the server
    # reports 0% hit rate throughout -- so warm ~= cold here rather than being
    # the big win it is on Muse. Kept because that gap is itself the finding.
    prompt_for
    measure_conc "$c" >/dev/null
    read -r w_ttft dec agg _ _ < <(med_of "$c" 3)
    pf=$(echo "scale=0; ${ptok:-0} * 1000 / (${c_ttft:-1} + 1)" | bc)
    printf '  %-16s %5s %9sms %9s/s %9sms %11s/s %10s/s\n' \
           "" "$c" "$c_ttft" "$pf" "$w_ttft" "$dec" "$agg"
    echo "| $label | $c | $c_ttft | $pf | $w_ttft | $dec | $agg |" >> "$RESULTS"
    jrec "$label" "$c" "${c_ttft:-0}" "${w_ttft:-0}" "${pf:-0}" "${dec:-0}" "${agg:-0}" "${ptok:-0}" "$envs"
  done
  echo
done

[[ -n "${LOGS_PID:-}" ]] && kill "$LOGS_PID" 2>/dev/null
stop_server
echo "## done -- table in $RESULTS, records in $JSONL"
