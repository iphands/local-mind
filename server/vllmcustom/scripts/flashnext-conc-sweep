#!/usr/bin/env bash
# Does MTP still pay with several conversations at once? FP4-Local, launcher defaults, K x streams.
#
#   REPLACE=1 ./scripts/flashnext-conc-sweep                # K = 0,1,2,3 x streams 1,2,4, code prompt
#   KS=0,2,3 CONC=1,4 ROUNDS=4 ./scripts/flashnext-conc-sweep
#   PROMPTS=code,long ./scripts/flashnext-conc-sweep        # add the ~16k-context prompt (slower)
#
# Every number before this was single-stream, but the daily driver serves several conversations at
# once. With N streams each verify step already carries N tokens of real work, so a draft that pays
# for itself at batch 1 can be wasted at batch 4. This measures that trade on run-fp4local's own
# defaults (humming, probabilistic draft sampling, fp8 KV, util 0.975, MAX_NUM_SEQS 16). Only
# SPEC_TOKENS varies, plus SM120_SKINNY=0 (a measured no-op on FP4-Local that costs ~40 s of boot).
#
# Per K: boot detached, wait for /health, one unrecorded round at the largest stream count (JIT and
# graph warm-up for that batch size), then for each stream count in CONC and each prompt, ROUNDS
# recorded rounds of ./bench/conc. A round starts N streams together. Each has a unique prefix,
# so no stream rides another's prefix cache. ignore_eos is set, so each generates exactly the
# prompt's max_tokens.
#
# summary.md, per prompt x streams x K:
#   per-stream tok/s   what one user sees: mean over rounds of the round's mean stream rate (min-max)
#   aggregate tok/s    what the box delivers: all tokens / (last end - first first-token) (min-max)
#   vs K=0             both ratios against K=0 at the same stream count and prompt
#   accept len         1 + accepted / drafts over the rounds (vLLM's formula), from /metrics deltas
#   TTFT ms            mean over every stream (N concurrent cold prefills, so it rises with N)
#
# Output: bench/bench-logs/flashnext-conc-<UTC stamp>/
#   summary.md  results.jsonl (one ./bench/conc record per round)  k<K>.log (launcher + container)
# It STOPS the server it benchmarks and leaves nothing running; a running `vllm` container makes it
# refuse unless REPLACE=1. SPEC_TOKENS=1 hung at boot on the old PR-branch image; a hang costs
# READY_TIMEOUT (1500 s) and becomes a BOOT FAILED line.
set -uo pipefail   # NOT -e: one K failing to boot must not lose the others

HERE=$(cd "$(dirname "$0")/.." && pwd)
NAME=vllm
PORT=${PORT:-8700}
HOST="localhost:${PORT}"
READY_TIMEOUT=${READY_TIMEOUT:-1500}
ROUNDS=${ROUNDS:-3}
KS=${KS:-0,1,2,3}
CONC=${CONC:-1,2,4}
PROMPTS=${PROMPTS:-code}
LAUNCHER=${LAUNCHER:-qwen3.8-flash-next/run-fp4local}   # relative to the repo, or absolute
[[ $LAUNCHER == /* ]] || LAUNCHER=$HERE/$LAUNCHER
CONC_TOOL=${CONC_TOOL:-$HERE/bench/conc}
OUT=${OUT:-$HERE/bench/bench-logs/flashnext-conc-$(date -u +%Y%m%d-%H%M%S)}
LOGS_PID=
trap '[[ -n "${LOGS_PID:-}" ]] && kill "$LOGS_PID" 2>/dev/null' EXIT

# Knobs the caller set, captured before anything here could set them (summary.md lists these).
CALLER_SET=()
for v in DRAFT_SAMPLE GPU_MEM_UTIL KV_FP8 KV_NVFP4 MAX_NUM_SEQS MAX_BATCHED_TOKENS MOE_BACKEND VISION EXTRA_ARGS ENV_EXTRA; do
  [[ -v $v ]] && CALLER_SET+=("$v")
done

# shellcheck source-path=SCRIPTDIR source=../bench/_bench-lib.sh
source "$HERE/bench/_bench-lib.sh"
for tool in curl docker awk python3; do
  command -v "$tool" >/dev/null || { echo "## need $tool"; exit 2; }
done
[[ -x $LAUNCHER ]] || { echo "## no launcher at $LAUNCHER"; exit 2; }
[[ $ROUNDS =~ ^[1-9][0-9]*$ ]] || { echo "## ROUNDS must be a positive integer (got '$ROUNDS')"; exit 2; }
[[ $KS =~ ^[0-9]+(,[0-9]+)*$ ]] || { echo "## KS must be a comma list like 0,1,2,3 (got '$KS')"; exit 2; }
[[ $CONC =~ ^[1-9][0-9]*(,[1-9][0-9]*)*$ ]] || { echo "## CONC must be a comma list of stream counts like 1,2,4 (got '$CONC')"; exit 2; }
[[ $PROMPTS =~ ^(short|code|long)(,(short|code|long))*$ ]] || { echo "## PROMPTS must be a comma list of short,code,long (got '$PROMPTS')"; exit 2; }
IFS=, read -r -a KLIST <<<"$KS"
IFS=, read -r -a CLIST <<<"$CONC"
IFS=, read -r -a PLIST <<<"$PROMPTS"
MAXC=$(printf '%s\n' "${CLIST[@]}" | sort -n | tail -1)
if [[ -n ${MAX_NUM_SEQS:-} ]] && (( MAX_NUM_SEQS < MAXC )); then
  echo "## MAX_NUM_SEQS=$MAX_NUM_SEQS is below the largest stream count $MAXC: the extra streams would queue, not run"
  exit 2
fi
if docker ps -q -f "name=^${NAME}$" | grep -q . && [[ ${REPLACE:-0} != 1 ]]; then
  echo "## a '$NAME' container is running; this script stops it. Re-run with REPLACE=1 to allow that."
  exit 2
fi

mkdir -p "$OUT"
: > "$OUT/results.jsonl"
declare -A BACKEND READY

echo "## flashnext-conc-sweep -> $OUT"
echo "##   launcher $LAUNCHER, K in {$KS} x streams {$CONC} x prompts {$PROMPTS}, $ROUNDS rounds each"

for k in "${KLIST[@]}"; do
  log="$OUT/k$k.log"; : > "$log"
  [[ -n "${LOGS_PID:-}" ]] && kill "$LOGS_PID" 2>/dev/null; LOGS_PID=
  stop_server
  echo "## [k$k] booting  (SPEC_TOKENS=$k SM120_SKINNY=0, launcher defaults otherwise)"
  boot_t0=$(date +%s)
  SPEC_TOKENS=$k SM120_SKINNY=0 DETACH=1 PORT="$PORT" "$LAUNCHER" >> "$log" 2>&1
  docker logs -f "$NAME" >> "$log" 2>&1 & LOGS_PID=$!
  if ! wait_ready; then
    echo "## [k$k] BOOT FAILED -- see $log"
    BACKEND[$k]="boot failed"; READY[$k]=-
    continue
  fi
  READY[$k]=$(( $(date +%s) - boot_t0 ))
  BACKEND[$k]=$(grep -oE "Using '[A-Z0-9_]+' NvFp4 MoE backend" "$log" | head -1 | grep -oE "'[A-Z0-9_]+'" | tr -d "'")
  echo "## [k$k] ready in ${READY[$k]}s, MoE backend ${BACKEND[$k]:-<not logged>}"

  # Warm-up at the largest batch, every prompt: compiles and graph sizes are paid here, not measured.
  for prompt in "${PLIST[@]}"; do
    PYTHONDONTWRITEBYTECODE=1 "$CONC_TOOL" "k$k-warmup" --streams "$MAXC" --prompt "$prompt" --host "$HOST" \
      >> "$OUT/k$k.warmup" 2>&1 || echo "## [k$k] warm-up ($prompt) reported a failure -- see k$k.warmup"
  done
  for prompt in "${PLIST[@]}"; do
    for c in "${CLIST[@]}"; do
      if PYTHONDONTWRITEBYTECODE=1 "$CONC_TOOL" "k$k" --streams "$c" --prompt "$prompt" --rounds "$ROUNDS" --host "$HOST" \
           > "$OUT/.round.jsonl" 2> "$OUT/.round.err"; then :; else
        echo "## [k$k] $prompt x$c: $(tail -1 "$OUT/.round.err")"
      fi
      cat "$OUT/.round.jsonl" >> "$OUT/results.jsonl"
      echo "## [k$k] $prompt x$c done ($(wc -l < "$OUT/.round.jsonl") rounds)"
    done
  done
  rm -f -- "$OUT/.round.jsonl" "$OUT/.round.err"
done

[[ -n "${LOGS_PID:-}" ]] && kill "$LOGS_PID" 2>/dev/null; LOGS_PID=
stop_server

summarize() {
  python3 -I - "$OUT/results.jsonl" "$KS" "$CONC" "$PROMPTS" <<'PY'
import json, sys
from collections import defaultdict
path, ks, cs, ps = sys.argv[1], *[a.split(",") for a in sys.argv[2:5]]
ks, cs = [int(k) for k in ks], [int(c) for c in cs]
rows = defaultdict(list)
for line in open(path):
    line = line.strip()
    if not line:
        continue
    r = json.loads(line)
    if "mean_stream_tps" not in r:
        continue
    rows[(r["prompt"], r["streams"], int(r["label"][1:]))].append(r)

def stat(xs):
    return sum(xs) / len(xs), min(xs), max(xs)

print("| prompt | streams | K | rounds | per-stream tok/s mean (min–max) | vs K=0 | aggregate tok/s mean (min–max) | vs K=0 | accept len | TTFT ms |")
print("|---|---|---|---|---|---|---|---|---|---|")
for p in ps:
    for c in cs:
        base = rows.get((p, c, 0))
        b_s = stat([r["mean_stream_tps"] for r in base])[0] if base else None
        b_a = stat([r["agg_tps"] for r in base])[0] if base else None
        for k in ks:
            rs = rows.get((p, c, k))
            if not rs:
                print(f"| {p} | {c} | {k} | 0 | no data | | | | | |")
                continue
            s_m, s_lo, s_hi = stat([r["mean_stream_tps"] for r in rs])
            a_m, a_lo, a_hi = stat([r["agg_tps"] for r in rs])
            d = sum(r["drafts"] for r in rs); a = sum(r["accepted"] for r in rs)
            al = f"{1 + a / d:.2f}" if d else "1.00"
            tt = [t for r in rs for t in r["ttft_ms"]]
            vs_s = f"{s_m / b_s:.2f}x" if b_s else "-"
            vs_a = f"{a_m / b_a:.2f}x" if b_a else "-"
            print(f"| {p} | {c} | {k} | {len(rs)} | {s_m:.1f} ({s_lo:.1f}–{s_hi:.1f}) | {vs_s} | "
                  f"{a_m:.1f} ({a_lo:.1f}–{a_hi:.1f}) | {vs_a} | {al} | {sum(tt) / len(tt):.0f} |")
PY
}

{
  echo "# flashnext-conc-sweep $(date -u '+%Y-%m-%d %H:%M UTC')"
  echo
  echo "Launcher \`$LAUNCHER\`, launcher defaults + SPEC_TOKENS=K, SM120_SKINNY=0. K in {$KS}, streams {$CONC}, prompts {$PROMPTS}, $ROUNDS rounds each."
  for v in "${CALLER_SET[@]}"; do printf 'Set: %s=%s  \n' "$v" "${!v}"; done
  grep -h -m1 '^## Running' "$OUT"/k*.log 2>/dev/null | sed 's/^## Running /Image: /; s/  (.*//' | sort -u
  echo
  for k in "${KLIST[@]}"; do
    if [[ ${BACKEND[$k]:-} == "boot failed" ]]; then printf -- '- K=%s: **BOOT FAILED** (see k%s.log)\n' "$k" "$k"
    else printf -- '- K=%s: MoE backend %s, boot %ss\n' "$k" "${BACKEND[$k]:-?}" "${READY[$k]:-?}"; fi
  done
  echo
  summarize
  echo
  echo "per-stream = what one conversation sees; aggregate = all streams' tokens / wall time, what the GPU"
  echo "delivers. vs K=0 compares at the same stream count. Ranges are over rounds; a ratio whose ranges"
  echo "overlap K=0's is noise."
} > "$OUT/summary.md"

cat "$OUT/summary.md"
echo
echo "## done -- $OUT (summary.md, results.jsonl, per-K .log). Nothing is running now."
