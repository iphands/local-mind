#!/bin/bash
# Serve a model with the locally-built sm120 vLLM image (no docker pull).
#
#   ./run ./models/vllm/Qwen3.6-27B
#   ./run ./models/vllm/Qwen3.5-122B-A10B-NVFP4
#
# A/B backends/knobs without editing this file:
#   ATTN_BACKEND=flashinfer ./run <model>
#   ATTN_BACKEND=triton MOE_BACKEND=flashinfer_trtllm ./run <model>
#   NVFP4_BACKEND=cutlass ./run <model>       # NVFP4 GEMM kernel: cutlass | flashinfer-cudnn |
#                                             #   flashinfer-cutlass | marlin | flashinfer-trtllm |
#                                             #   flashinfer-b12x (SM12x CuTe DSL kernel)
#                                             #   (default cutlass = bench-fastest on sm120f).
#                                             #   flashinfer-cudnn=safe fallback if FP4 GEMM hits the
#                                             #   race-cond NaN; marlin=W4A16 fallback if FP4 misbehaves.
#   MOE_BACKEND=flashinfer_b12x ./run <model> # SM12x fused MoE (excluded from vLLM auto-select; opt-in)
#   SPEC_TOKENS=8 ./run <model>               # DFlash draft tokens (default 15 per model card; 0 = speculation off)
#   CUDAGRAPH_MODE=FULL_AND_PIECEWISE ./run <model>   # full CUDA graphs (small-batch decode A/B)
#   FLASHINFER_AUTOTUNE=1 ./run <model>       # FlashInfer autotuning during warmup
#   MAX_BATCHED_TOKENS=32768 ./run <model>    # faster long-context prefill (default 8192)
#   IMAGE_TAG=cu1312-sm120 ./run <model>      # run a specific build variant
#   EXTRA_ARGS="--max-num-seqs 8" ./run <model>
#
# Benchmark a variant against the running server: ./bench <label>
set -euo pipefail

NAME=vllm
IMAGE=${IMAGE:-iphands/vllm-blackwell}
IMAGE_TAG=${IMAGE_TAG:-latest}
CONTAINER="$IMAGE:$IMAGE_TAG"

MODEL_PATH=${1:?usage: ./run <path-to-model-dir>   (e.g. ./run ./models/vllm/Qwen3.6-27B)}
# basename/dirname (vs ${x%/*}) tolerate trailing slashes and slash-less paths
MODEL=$(basename "$MODEL_PATH")
MODEL_FOLDER=$(cd "$(dirname "$MODEL_PATH")" && pwd)   # absolute, for the bind mount

PORT=${PORT:-8700}
ATTN_BACKEND=${ATTN_BACKEND:-flashinfer}
MOE_BACKEND=${MOE_BACKEND:-}                     # empty = vLLM default
NVFP4_BACKEND=${NVFP4_BACKEND:-cutlass}          # default cutlass = bench-fastest NVFP4 GEMM on sm120f
SPEC_TOKENS=${SPEC_TOKENS:-0}                   # DFlash draft tokens (15 = model-card recommendation)
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.90}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-262144}
MAX_BATCHED_TOKENS=${MAX_BATCHED_TOKENS:-8192}   # bigger (16384/32768) speeds long-context prefill/TTFT
CUDAGRAPH_MODE=${CUDAGRAPH_MODE:-}               # e.g. FULL_AND_PIECEWISE (A/B: full graphs help small-batch decode)
FLASHINFER_AUTOTUNE=${FLASHINFER_AUTOTUNE:-}     # 1 = run FlashInfer autotuning during warmup (A/B)
CACHE_DIR=${CACHE_DIR:-/mnt/noir/scratch/ai/vllm/cache}

docker image inspect "$CONTAINER" >/dev/null 2>&1 || {
  echo "Image $CONTAINER not found. Run ./build first."; exit 1; }

# DETACH=1 -> run backgrounded (-d) for scripted benchmarking (bench-wrapper);
# interactive (-it) otherwise.
if [[ -n "${DETACH:-}" ]]; then _RUNMODE=(-d); else _RUNMODE=(-it); fi

CONTAINER_ARGS=(
  run "${_RUNMODE[@]}" --rm
  --name "$NAME"
  # Force the `vllm serve` entrypoint (we pass `serve` as the first arg below).
  # Required for speculative decoding: only `vllm serve` copies the positional
  # model path onto the `model` field; the bare api_server module leaves `model`
  # at vLLM's default (Qwen/Qwen3-0.6B), so the MTP draft loads that default and
  # fails with "Unsupported speculative method: 'mtp'". --entrypoint REPLACES the
  # image ENTRYPOINT, so this works whether or not the image has been rebuilt.
  --entrypoint vllm
  --gpus device=0                                # RTX PRO 6000 only — never the 4060
  -e CUDA_DEVICE_ORDER=PCI_BUS_ID
  # NCCL vars are inert on this single-GPU deployment; kept in case TP/PP ever >1
  -e NCCL_P2P_LEVEL=4
  -e NCCL_IB_DISABLE=1
  -e VLLM_WORKER_MULTIPROC_METHOD=spawn
  -e SAFETENSORS_FAST_GPU=1
  -e VLLM_LOG_STATS_INTERVAL=1                   # log tok/s + MTP acceptance every 1s (tuning)
  -e VLLM_SLEEP_WHEN_IDLE=1                       # release SMs when no requests pending (idle power)
  -p "0.0.0.0:${PORT}:8799"
  -v "$MODEL_FOLDER":/models:ro
  -v "$CACHE_DIR":/root/.cache:rw
  --ipc=host
  --shm-size=32g
  --ulimit memlock=-1
  --ulimit stack=67108864
)

VLLM_ARGS=(
  /models/"$MODEL"
  --served-model-name cosmo-6000 cosmo-proxy claude-heavy claude-light claude-haiku-4-5-20251001
  --host 0.0.0.0
  --port 8799

  --async-scheduling
  --dtype auto
  --enable-auto-tool-choice
  --gpu-memory-utilization "$GPU_MEM_UTIL"
  --language-model-only
  --max-model-len "$MAX_MODEL_LEN"
  --pipeline-parallel-size 1
  --tensor-parallel-size 1
  --trust-remote-code

  --enable-prefix-caching
  --enable-chunked-prefill
  --enable-prompt-tokens-details              # usage reports cached_tokens (bench logs prefix-cache hits)
  --max-num-seqs 3
  --max-num-batched-tokens "$MAX_BATCHED_TOKENS"

  --attention-backend "$ATTN_BACKEND"
  --no-enforce-eager

  --tool-call-parser poolside_v1
  --reasoning-parser poolside_v1
  --override-generation-config '{"temperature":0.7,"top_p":0.95}'

  # --override-generation-config '{ "temperature": 0.6, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0, "repetition_penalty": 1.0 }'
  --default-chat-template-kwargs '{"enable_thinking": true, "preserve_thinking": true}'
  --kv-cache-dtype fp8
)

# SPEC_TOKENS=0 disables speculation entirely (clean baseline); else add the DFlash
# draft. Local copy beside the target model so the single /models mount covers both.
[[ "$SPEC_TOKENS" != "0" ]] && VLLM_ARGS+=( --speculative-config \
  '{"method":"dflash","model":"/models/Laguna-S-2.1-DFlash-NVFP4","num_speculative_tokens":'"$SPEC_TOKENS"'}' )
[[ -n "$MOE_BACKEND" ]] && VLLM_ARGS+=( --moe-backend "$MOE_BACKEND" )
# NVFP4 GEMM backend: the VLLM_NVFP4_GEMM_BACKEND env is deprecated in v0.23
# ("Use --linear-backend"), so pass the flag. Exception: flashinfer-b12x isn't in
# the --linear-backend choices yet — only the env still routes to it.
if [[ -n "$NVFP4_BACKEND" ]]; then
  if [[ "$NVFP4_BACKEND" == "flashinfer-b12x" ]]; then
    CONTAINER_ARGS+=( -e VLLM_NVFP4_GEMM_BACKEND="$NVFP4_BACKEND" )
  else
    VLLM_ARGS+=( --linear-backend "$NVFP4_BACKEND" )   # vLLM lowercases and maps - to _
  fi
fi
[[ -n "$CUDAGRAPH_MODE" ]] && VLLM_ARGS+=( --compilation-config '{"cudagraph_mode":"'"$CUDAGRAPH_MODE"'"}' )
[[ -n "$FLASHINFER_AUTOTUNE" ]] && VLLM_ARGS+=( --enable-flashinfer-autotune )
# shellcheck disable=SC2206
[[ -n "${EXTRA_ARGS:-}" ]] && VLLM_ARGS+=( ${EXTRA_ARGS} )

echo
echo "## Running $CONTAINER  (attn=$ATTN_BACKEND moe=${MOE_BACKEND:-default} gpu0)"
echo docker "${CONTAINER_ARGS[@]}" "$CONTAINER" serve "${VLLM_ARGS[@]}"
docker "${CONTAINER_ARGS[@]}" "$CONTAINER" serve "${VLLM_ARGS[@]}"
