#!/usr/bin/env python3
"""N simultaneous streams against an OpenAI-compatible server: per-stream and aggregate decode.

    ./bench/conc k3-c4 --streams 4 --prompt code          # one round, one JSON line on stdout
    ./bench/conc k3-c4 --streams 4 --prompt long --rounds 3

Each round starts N threads behind a barrier. Every stream sends one of ./bench/bench's prompts,
with a unique tag at the FRONT so no stream shares a prefix-cache hit with another or with an
earlier round (vLLM caches by prefix, so a suffix tag would still hit). ignore_eos makes every
stream generate exactly max_tokens. Per round it prints one JSON object:

  stream_tps   completion_tokens / (total - ttft) per stream: what one user sees
  agg_tps      all completion tokens / (last stream end - first first-token): what the box delivers
  ttft_ms      per stream (concurrent cold prefills, so it grows with N)
  drafts / draft_tokens / accepted / accepted_per_pos
               deltas of vLLM's spec-decode counters on /metrics across the round (0 with MTP off).
               Exact for the round because nothing else is sent meanwhile.
"""
import argparse
import json
import re
import runpy
import sys
import threading
import time
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE / "lib"))
from benchclient import stream_chat  # noqa: E402

# The prompt set is bench's own, so the two tools measure the same requests.
PROMPTS = {name: (text, mt) for name, text, mt in runpy.run_path(str(HERE / "bench"), run_name="bench_prompts")["PROMPTS"]}

_COUNTER = re.compile(r'^vllm:spec_decode_num_(drafts|draft_tokens|accepted_tokens|accepted_tokens_per_pos)_total(\{[^}]*\})?\s+(\S+)')
_POS = re.compile(r'position="(\d+)"')


def spec_counters(host):
    """Spec-decode counters summed over engines; zeros when the server exports none (MTP off)."""
    out = {"drafts": 0, "draft_tokens": 0, "accepted_tokens": 0, "per_pos": {}}
    try:
        with urllib.request.urlopen(f"http://{host}/metrics", timeout=10) as r:
            text = r.read().decode("utf-8", "replace")
    except Exception:
        return out
    for line in text.splitlines():
        m = _COUNTER.match(line)
        if not m:
            continue
        name, labels, value = m.group(1), m.group(2) or "", float(m.group(3))
        if name == "accepted_tokens_per_pos":
            p = _POS.search(labels)
            if p:
                out["per_pos"][int(p.group(1))] = out["per_pos"].get(int(p.group(1)), 0) + value
        else:
            out[name] += value
    return out


def one_round(args, rnd):
    text, max_tokens = PROMPTS[args.prompt]
    n = args.streams
    barrier = threading.Barrier(n)
    results = [None] * n

    def worker(i):
        tag = f"[{args.label} round {rnd} stream {i} {time.time_ns()}]\n\n"
        barrier.wait()
        t0 = time.perf_counter()
        try:
            r = stream_chat(args.host, args.model, [{"role": "user", "content": tag + text}],
                            max_tokens, ignore_eos=True, timeout=args.timeout)
            results[i] = {"t0": t0, **r}
        except Exception as e:  # one failed stream is reported, not fatal
            results[i] = {"t0": t0, "error": str(e)}

    before = spec_counters(args.host)
    threads = [threading.Thread(target=worker, args=(i,)) for i in range(n)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    time.sleep(1)  # let the last step's stats reach the API server's counters
    after = spec_counters(args.host)

    ok = [r for r in results if r and "error" not in r]
    rec = {"label": args.label, "streams": n, "prompt": args.prompt, "round": rnd,
           "errors": [r["error"] for r in results if r and "error" in r]}
    if ok:
        stream_tps = [r["completion_tokens"] / max(r["total"] - r["ttft"], 1e-6) for r in ok]
        first = min(r["t0"] + r["ttft"] for r in ok)
        last = max(r["t0"] + r["total"] for r in ok)
        rec.update({
            "stream_tps": [round(x, 2) for x in stream_tps],
            "mean_stream_tps": round(sum(stream_tps) / len(stream_tps), 2),
            "agg_tps": round(sum(r["completion_tokens"] for r in ok) / max(last - first, 1e-6), 2),
            "ttft_ms": [round(r["ttft"] * 1000, 1) for r in ok],
            "completion_tokens": sum(r["completion_tokens"] for r in ok),
        })
    rec.update({
        "drafts": int(after["drafts"] - before["drafts"]),
        "draft_tokens": int(after["draft_tokens"] - before["draft_tokens"]),
        "accepted": int(after["accepted_tokens"] - before["accepted_tokens"]),
        "accepted_per_pos": [int(after["per_pos"].get(i, 0) - before["per_pos"].get(i, 0))
                             for i in sorted(set(after["per_pos"]) | set(before["per_pos"]))],
    })
    return rec


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("label")
    ap.add_argument("--streams", type=int, default=1)
    ap.add_argument("--prompt", default="code", choices=sorted(PROMPTS))
    ap.add_argument("--rounds", type=int, default=1)
    ap.add_argument("--host", default="localhost:8700")
    ap.add_argument("--model", default="cosmo-6000")
    ap.add_argument("--timeout", type=int, default=900)
    args = ap.parse_args()
    if args.streams < 1 or args.rounds < 1:
        ap.error("--streams and --rounds must be >= 1")
    for rnd in range(1, args.rounds + 1):
        rec = one_round(args, rnd)
        print(json.dumps(rec), flush=True)
        if "mean_stream_tps" not in rec:
            sys.exit(f"round {rnd}: every stream failed: {rec['errors'][:1]}")


if __name__ == "__main__":
    main()
