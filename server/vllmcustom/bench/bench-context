#!/usr/bin/env bash
# Large-context decode benchmark: how TG (token-gen tok/s) degrades as the KV cache
# fills, measured two ways, across the NVFP4 backend matrix.
#
#   ./bench/bench-context                                   # ALL permutations (see DEFAULT_CONFIGS): long!
#   ./bench/bench-context /path/to/model
#   PAD_SIZES="8192 32768" CONFIGS=$'cutlass cutlass 2' ./bench/bench-context   # quick subset
#
# Two modes per backend (one vLLM launch each), driven by lib/ctxbench.py:
#   convo : 3-turn conversation -- (1) Bash primes (dynamic), (2) port to Python
#           (dynamic), (3) static "summarize this Quake II source" turn loaded from
#           data/test-convo.json (run ./bench/make-test-convo first). Turn 3 injects ~120k
#           tokens of real C source, so it measures decode at large depth inside a
#           realistic chat (history resent each turn -> exercises prefix caching).
#   pad   : prompt padded to exact PAD_SIZES (8k/32k/64k/128k), short generation,
#           clean decode-vs-context curve comparable across backends.
#
# Primary metric is TG at depth. TTFT/prefill are secondary (prefix caching keeps
# convo TTFT low). Each measurement records the ACTUAL context depth (prompt_tokens)
# and the GPU0 watt cap. Outputs: printed tables (+ bench-context-results.md) and
# rows appended to the shared bench-results.jsonl.
set -uo pipefail   # NOT -e: survive a failing config/turn and keep going

HERE=$(cd "$(dirname "$0")" && pwd)
MODEL=${1:-/mnt/noir/scratch/ai/llm/models/vllm/Qwen3.5-122B-A10B-NVFP4}
MODELBASE=$(basename "$MODEL")
NAME=vllm                                    # every */run uses this name (one model up at a time)
PORT=${PORT:-8700}
HOST="localhost:${PORT}"
APIMODEL=${APIMODEL:-cosmo-6000}
READY_TIMEOUT=${READY_TIMEOUT:-1200}

PAD_SIZES=${PAD_SIZES:-"8192 32768 65536 131072"}
TESTCONVO=${TESTCONVO:-$HERE/data/test-convo.json}   # static quake2 turn (./bench/make-test-convo)
GEN_CONVO=${GEN_CONVO:-1024}                 # tokens generated for the dynamic convo turns
GEN_SUMMARY=${GEN_SUMMARY:-512}              # tokens generated for the big quake2 summarize turn
GEN_PAD=${GEN_PAD:-256}                       # tokens generated per pad probe
WARMUP_PROMPT="Write a pure bash script to draw ascii art mandlebrot set"
WARMUP_TOKENS=${WARMUP_TOKENS:-512}

LOGDIR=${LOGDIR:-$HERE/bench-logs}
RESULTS=${RESULTS:-$HERE/bench-context-results.md}
JSONL=${JSONL:-$HERE/bench-results.jsonl}
MEASURE="$HERE/lib/measure.py"               # warmup + watts helper
CTX="$HERE/lib/ctxbench.py"                  # convo + pad driver
mkdir -p "$LOGDIR"

# Backend matrix: "<name> <NVFP4_BACKEND|-> <SPEC_TOKENS> [MOE_BACKEND|-]".
# '-'=auto, SPEC 0=MTP off, MoE column optional (default '-').
# DEFAULT = ALL permutations: {auto, cutlass, flashinfer-cudnn, marlin} x MTP {0,1,2}
# plus the SM12x-specific b12x GEMM/MoE opt-ins = 14 configs. This is LONG (each =
# full 122B reload + large convo + pad to 128k); trim with CONFIGS=... for a faster
# pass. MTP can crash at long context (illegal mem access) — the mtp0 rows give a
# clean number if an mtpN config dies mid-convo.
DEFAULT_CONFIGS="\
auto-mtp0     -                0
auto-mtp1     -                1
auto-mtp2     -                2
cutlass-mtp0  cutlass          0
cutlass-mtp1  cutlass          1
cutlass-mtp2  cutlass          2
cudnn-mtp0    flashinfer-cudnn 0
cudnn-mtp1    flashinfer-cudnn 1
cudnn-mtp2    flashinfer-cudnn 2
marlin-mtp0   marlin           0
marlin-mtp1   marlin           1
marlin-mtp2   marlin           2
b12x-mtp2     flashinfer-b12x  2
b12xmoe-mtp2  cutlass          2  flashinfer_b12x"
CONFIGS=${CONFIGS:-$DEFAULT_CONFIGS}

source "$HERE/_bench-lib.sh"   # stop_server, wait_ready (uses NAME/HOST/READY_TIMEOUT)

{
  echo "## bench-context  model=$MODELBASE  pad=[$PAD_SIZES]  testconvo=$(basename "$TESTCONVO")"
  echo "## $(date -u +'%Y-%m-%d %H:%M UTC')"
} | tee -a "$RESULTS"

while read -r cfg_name nvfp4 spec moe; do
  [[ -z "${cfg_name:-}" ]] && continue
  moe=${moe:--}
  watts=$(python3 "$MEASURE" --print-watts 2>/dev/null); [[ -z "$watts" ]] && watts="-"
  nvfp4_env=""; nvfp4_disp="auto"; [[ "$nvfp4" != "-" ]] && nvfp4_env="$nvfp4" && nvfp4_disp="$nvfp4"
  moe_env=""; moe_disp="auto"; [[ "$moe" != "-" ]] && moe_env="$moe" && moe_disp="$moe"
  hdr="=== $cfg_name  (NVFP4=$nvfp4_disp  MTP=$spec  MOE=$moe_disp  GPU0 cap=${watts}W) ==="
  echo; echo "$hdr" | tee -a "$RESULTS"

  stop_server
  start_log="$LOGDIR/start-ctx-$cfg_name.log"
  echo "    launching vLLM ..."
  DETACH=1 PORT="$PORT" NVFP4_BACKEND="$nvfp4_env" SPEC_TOKENS="$spec" MOE_BACKEND="$moe_env" \
    "$HERE/../qwen/run" "$MODEL" > "$start_log" 2>&1

  if ! wait_ready; then
    echo "    NOT READY -> see $start_log" | tee -a "$RESULTS"
    docker logs "$NAME" > "$LOGDIR/crash-ctx-$cfg_name.log" 2>&1 || true
    stop_server; continue
  fi
  image=$(docker inspect "$NAME" --format '{{.Config.Image}}' 2>/dev/null || true)
  # warmup: flashinfer JIT/autotune + CUDA-graph capture would otherwise pollute
  # the first convo turn's TTFT (seen as ~7s TTFT on a 46-token prompt)
  echo "    ready. warmup ..."
  python3 "$MEASURE" "$HOST" "$APIMODEL" "$WARMUP_PROMPT" "$WARMUP_TOKENS" >/dev/null 2>&1 || true
  echo "    running convo + pad ..."
  python3 "$CTX" "$HOST" "$APIMODEL" \
    --jsonl "$JSONL" --config "$cfg_name" --nvfp4 "$nvfp4_env" --moe "$moe_env" \
    --mtp "$spec" --model-name "$MODELBASE" --image "$image" \
    --pad-sizes "$PAD_SIZES" --testconvo "$TESTCONVO" \
    --gen-convo "$GEN_CONVO" --gen-summary "$GEN_SUMMARY" --gen-pad "$GEN_PAD" \
    2>&1 | tee -a "$RESULTS"
  stop_server
done <<< "$CONFIGS"

echo
echo "## tables -> $RESULTS    per-measurement jsonl -> $JSONL"
