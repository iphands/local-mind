#!/bin/bash
# Serve a model with the locally-built sm120 vLLM image (no docker pull).
#
#   ./laguna/run                                     # Laguna-S-2.1-NVFP4 (default)
#   ./laguna/run ./models/vllm/Laguna-S-2.1-NVFP4    # a path under models/vllm ...
#   ./laguna/run Laguna-S-2.1-NVFP4                  # ... or just its name
#
# A/B backends/knobs without editing this file:
#   ATTN_BACKEND=flashinfer ./laguna/run <model>
#   ATTN_BACKEND=triton MOE_BACKEND=flashinfer_trtllm ./laguna/run <model>
#   NVFP4_BACKEND=cutlass ./laguna/run <model>       # NVFP4 GEMM kernel: cutlass | flashinfer-cudnn |
#                                             #   flashinfer-cutlass | marlin | flashinfer-trtllm |
#                                             #   flashinfer-b12x (SM12x CuTe DSL kernel)
#                                             #   (default cutlass = bench-fastest on sm120f).
#                                             #   flashinfer-cudnn=safe fallback if FP4 GEMM hits the
#                                             #   race-cond NaN; marlin=W4A16 fallback if FP4 misbehaves.
#   MOE_BACKEND=flashinfer_b12x ./laguna/run <model> # SM12x fused MoE (excluded from vLLM auto-select; opt-in)
#   SPEC_TOKENS=8 ./laguna/run <model>               # DFlash draft tokens (default 15 per model card; 0 = speculation off)
#   CUDAGRAPH_MODE=FULL_AND_PIECEWISE ./laguna/run <model>   # full CUDA graphs (small-batch decode A/B)
#   FLASHINFER_AUTOTUNE=1 ./laguna/run <model>       # FlashInfer autotuning during warmup
#   MAX_BATCHED_TOKENS=32768 ./laguna/run <model>    # faster long-context prefill (default 8192)
#   IMAGE_TAG=cu1312-sm120 ./laguna/run <model>      # run a specific build variant
#   EXTRA_ARGS="--max-num-seqs 8" ./laguna/run <model>
#
# Benchmark a variant against the running server: ./bench/bench <label>
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=../common/_run-lib.sh
source "$HERE/../common/_run-lib.sh"

# shellcheck disable=SC2034  # read by docker_core_args in common/_run-lib.sh
NAME=vllm
vllm_image

# shellcheck disable=SC2034  # read by resolve_model in common/_model-lib.sh
DEFAULT_MODEL=Laguna-S-2.1-NVFP4                 # relative to MODEL_ROOT (./models/vllm)
resolve_model "${1:-}"

PORT=${PORT:-8700}
ATTN_BACKEND=${ATTN_BACKEND:-flashinfer}
MOE_BACKEND=${MOE_BACKEND:-}                     # empty = vLLM default
NVFP4_BACKEND=${NVFP4_BACKEND:-cutlass}          # default cutlass = bench-fastest NVFP4 GEMM on sm120f
SPEC_TOKENS=${SPEC_TOKENS:-0}                    # DFlash draft tokens (15 = model-card recommendation)
DRAFT=${DRAFT:-Laguna-S-2.1-DFlash-NVFP4}        # relative to MODEL_ROOT, i.e. beside the target model
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.90}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-262144}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-3}
MAX_BATCHED_TOKENS=${MAX_BATCHED_TOKENS:-8192}   # bigger (16384/32768) speeds long-context prefill/TTFT
CUDAGRAPH_MODE=${CUDAGRAPH_MODE:-}               # e.g. FULL_AND_PIECEWISE (A/B: full graphs help small-batch decode)
FLASHINFER_AUTOTUNE=${FLASHINFER_AUTOTUNE:-}     # 1 = run FlashInfer autotuning during warmup (A/B)
CACHE_DIR=${CACHE_DIR:-/mnt/noir/scratch/ai/vllm/cache}

require_image

# The drafter is mounted through the same /models as the target, so it has to
# live under MODEL_ROOT. Check here rather than letting vLLM fail 60s into load.
if [[ "$SPEC_TOKENS" != "0" ]]; then
  [[ -d "$MODEL_FOLDER/$DRAFT" ]] || {
    echo "no DFlash drafter at $MODEL_FOLDER/$DRAFT -- use SPEC_TOKENS=0 or set DRAFT="; exit 1; }
fi

docker_core_args
CONTAINER_ARGS+=(
  # NCCL vars are inert on this single-GPU deployment; kept in case TP/PP ever >1
  -e NCCL_P2P_LEVEL=4
  -e NCCL_IB_DISABLE=1
  -e VLLM_SLEEP_WHEN_IDLE=1                      # release SMs when no requests pending (idle power)
)
env_extra_args

vllm_core_args
VLLM_ARGS+=(
  --enable-auto-tool-choice
  --language-model-only
  --no-enforce-eager
  --kv-cache-dtype fp8

  --tool-call-parser poolside_v1
  --reasoning-parser poolside_v1

  --override-generation-config '{"temperature":0.7,"top_p":0.95}'
  # --override-generation-config '{ "temperature": 0.6, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0, "repetition_penalty": 1.0 }'
  --default-chat-template-kwargs '{"enable_thinking": true, "preserve_thinking": true}'
)

# SPEC_TOKENS=0 disables speculation entirely (clean baseline); else add the DFlash
# draft. It sits beside the target model so the single /models mount covers both.
[[ "$SPEC_TOKENS" != "0" ]] && VLLM_ARGS+=( --speculative-config \
  '{"method":"dflash","model":"/models/'"$DRAFT"'","num_speculative_tokens":'"$SPEC_TOKENS"'}' )
nvfp4_backend_args
vllm_extra_args

echo
echo "## Running $CONTAINER  (attn=$ATTN_BACKEND moe=${MOE_BACKEND:-default} gpu0)"
vllm_launch
