#!/bin/bash
# Push the built image to Docker Hub. Run `docker login` first.
#
#   ./container/push                  # pushes what ./container/build last built (container/.last-build)
#   TAG=cu1303-sm120 ./container/push # push a specific variant tag
#   PUSH_DRY_RUN=1 ./container/push   # print the tags, push nothing
#
# Tags pushed, for vLLM 0.29.0 on CUDA 13.2.1 at commit d6d029f:
#
#   cu1321-sm120                     moving — newest build of this CUDA variant
#   cu1321-sm120-vllm0.29.0          pinned to the vLLM version
#   cu1321-sm120-vllm0.29.0-d6d029f  pinned to vLLM version *and* build commit
#   latest                           moving — newest build of anything
#
# Which image: $TAG if given, else the TAG ./container/build recorded in
# container/.last-build on its last successful run, else the CUDA variant of
# :latest (the old default, for images built before .last-build existed). So
# `VLLM_REF=main ./container/build && ./container/push` pushes the snapshot.
#
# A snapshot build (VLLM_REF=main) lives under its own tag family. Its version
# label is <next>.dev<date>+g<sha7>; the '+' is not legal in a docker tag and
# becomes '-', so the pinned tags read
# cu<cuda>-sm120-main-vllm<next>.dev<yyyymmdd>-g<sha7>[-<commit>]. Pushing a
# snapshot that was not built from VLLM_MAIN_SHA (container/versions.env) warns.
# :latest is only pushed when it IS the image being pushed (it never is for a
# snapshot; ./container/build does not retag :latest for those).
#
# The vLLM/CUDA versions are read from the image's own labels (stamped by the
# Dockerfile), not re-declared here. An earlier version of this script kept its
# own CUDA_VERSION with a "keep in sync with ./container/build" comment; that is exactly
# how a tag ends up claiming a version the image does not contain.
set -euo pipefail

IMAGE=${IMAGE:-iphands/vllm-blackwell}
REF=$(git rev-parse --short HEAD)
# The whole project dir, not the CWD — the dirty check below has to cover every
# subfolder that feeds a build, however this script was invoked.
root=$(cd "$(dirname "$0")/.." && pwd)

# shellcheck source-path=SCRIPTDIR source=versions.env
source "$root/container/versions.env"

# TAG still has to be derived without the image, since it is how we *find* the
# image: explicit TAG, then the last build, then the CUDA variant of :latest.
label() { docker image inspect -f "{{index .Config.Labels \"$1\"}}" "$2" 2>/dev/null; }

last_build="$root/container/.last-build"
if [[ -n ${TAG:-} ]]; then
  echo "## TAG=$TAG (from the environment)"
elif [[ -f $last_build ]]; then
  TAG=$(sed -n 's/^TAG=//p' "$last_build")
  _lb_image=$(sed -n 's/^IMAGE=//p' "$last_build")
  if [[ -n $_lb_image && $_lb_image != "$IMAGE" ]]; then
    echo "ERROR: container/.last-build is for $_lb_image, not $IMAGE. Pass TAG=... explicitly." >&2
    exit 1
  fi
  echo "## TAG=$TAG (from container/.last-build)"
fi

if [[ -z ${TAG:-} ]]; then
  cuda=$(label ai.vllmcustom.cuda.version "$IMAGE:latest")
  if [[ -z $cuda ]]; then
    echo "ERROR: $IMAGE:latest has no ai.vllmcustom.cuda.version label." >&2
    echo "       It predates label support — rebuild, or pass TAG=... explicitly." >&2
    exit 1
  fi
  TAG="cu${cuda//./}-sm120"
  echo "## TAG=$TAG (no container/.last-build: the CUDA variant of :latest)"
fi

docker image inspect "$IMAGE:$TAG" >/dev/null 2>&1 || {
  echo "Image $IMAGE:$TAG not found locally. Run ./container/build first."; exit 1; }

vllm_version=$(label ai.vllmcustom.vllm.version "$IMAGE:$TAG")
if [[ -z $vllm_version ]]; then
  echo "ERROR: $IMAGE:$TAG has no ai.vllmcustom.vllm.version label — cannot build a" >&2
  echo "       version-pinned tag. Rebuild with the current Dockerfile." >&2
  exit 1
fi

VTAG="${TAG}-vllm${vllm_version//+/-}"   # PEP 440 local segment '+' is not tag-legal
STAG="${VTAG}-${REF}"

vllm_ref=$(label ai.vllmcustom.vllm.ref "$IMAGE:$TAG")
if [[ $TAG == *-main && $vllm_ref != "$VLLM_MAIN_SHA" ]]; then
  echo "WARN: $IMAGE:$TAG was built from vLLM $vllm_ref, but container/versions.env pins"
  echo "      VLLM_MAIN_SHA=$VLLM_MAIN_SHA -- this is a stale snapshot. Rebuild with VLLM_REF=main first?"
fi

echo "## $IMAGE:$TAG carries vllm=$vllm_version ($(label ai.vllmcustom.vllm.ref "$IMAGE:$TAG")) torch=$(label ai.vllmcustom.torch.version "$IMAGE:$TAG") flashinfer=$(label ai.vllmcustom.flashinfer.version "$IMAGE:$TAG")"

# The pinned tags describe $TAG, NOT :latest — :latest may be a different (more
# recently built) variant, and a snapshot build never takes :latest at all. Only
# push :latest when it is this very image; otherwise pushing it would publish
# a different image under a name this run never looked at.
push_latest=0
if docker image inspect "$IMAGE:latest" >/dev/null 2>&1; then
  if [[ "$(docker image inspect -f '{{.Id}}' "$IMAGE:$TAG")" == \
        "$(docker image inspect -f '{{.Id}}' "$IMAGE:latest")" ]]; then
    push_latest=1
  else
    echo "WARN: $IMAGE:latest is a different image than $IMAGE:$TAG (another variant, or a snapshot?) — not pushing :latest"
  fi
fi

# The git SHA describes the build recipe, not the vLLM source; a dirty tree means
# the pushed image may not correspond to any commit.
if [[ -n "$(git status --porcelain -- "$root" 2>/dev/null)" ]]; then
  echo "WARN: working tree is dirty — :$STAG names commit $REF but the build used uncommitted changes."
fi

tags=("$TAG" "$VTAG" "$STAG")
(( push_latest )) && tags+=(latest)

if [[ ${PUSH_DRY_RUN:-0} == 1 ]]; then
  echo "## PUSH_DRY_RUN=1 — would tag and push:"
  for t in "${tags[@]}"; do echo "##   docker.io/$IMAGE:$t"; done
  exit 0
fi

docker tag "$IMAGE:$TAG" "$IMAGE:$VTAG"
docker tag "$IMAGE:$TAG" "$IMAGE:$STAG"

for t in "${tags[@]}"; do
  echo "## pushing docker.io/$IMAGE:$t"
  docker push "docker.io/$IMAGE:$t"
done
