#!/bin/bash
# Build the sm120-optimized vLLM image from source.
#
#   ./container/build                       # defaults from container/versions.env (the release set)
#   CUDA_VERSION=13.0.3 ./container/build   # the previous toolkit (produces a different tag, cu1303-sm120)
#   VLLM_REF=v0.25.1 ./container/build      # try a different vLLM (pin matching TORCH_REF/FLASHINFER_REF too)
#   VLLM_REF=v0.28.0 FLASHINFER_REF=v0.6.16.post3 ./container/build
#                                           # the previous set (same torch / torchaudio / torchvision)
#   VLLM_REF=main ./container/build         # SNAPSHOT: the main commit pinned in versions.env VLLM_MAIN_SHA, with its own
#                                           # flashinfer / torch / torchvision pins; tagged cu1321-sm120-main, never touches :latest
#                                           #   COST: if that snapshot's torch differs from the last one built, this is a FULL
#                                           #   multi-hour rebuild (torch -> torchaudio -> flashinfer -> vllm -> openai), not
#                                           #   an incremental one. The current pin (4d9a8d6) moved 2.13 -> 2.14, so it is.
#   VLLM_REF=<sha> FLASHINFER_REF=v0.6.x ./container/build
#                                           # any other untagged commit; pin flashinfer AND torch to ITS requirements/cuda.txt
#                                           #   (since vllm#52183 main wants torch 2.14, so a bare VLLM_REF=<recent-sha>
#                                           #    gets the release torch 2.13 and preflight refuses it — pass TORCH_REF= too)
#   BUILD_MEM_GB=64 ./container/build       # tighter memory budget (lowers the derived MAX_JOBS)
#   CTX_DIR= ./container/build              # build contexts straight from $BUILD_DIR/src (ships .git, see below)
#
# Memory: the build is capped at BUILD_MEM_GB (default 110G) two ways — a derived
# MAX_JOBS, plus a kernel-enforced cgroup ceiling if ./container/slice-setup has
# been run once as root. See "Memory-capped builds" in the README.
#
# Source trees are cloned/pulled into $BUILD_DIR/src once and reused (no re-clone).
# Patch or `git checkout` them in place; this script only fetches + checks out the pinned ref.
# docker build does not read them there: it gets rsync'd copies without .git from
# $CTX_DIR (default $BUILD_DIR/ctx). BuildKit transfers a whole build context before
# any COPY --exclude applies, and pytorch's .git alone is 6 GB of the 8 GB tree.
#
# Every version default lives in container/versions.env (with the reasons for
# each pin); this script only applies them. After a successful build it records
# what it built in container/.last-build, which ./container/push reads.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=versions.env
source "$here/versions.env"

# --- knobs (override via env) ------------------------------------------------
CUDA_VERSION=${CUDA_VERSION:-$DEFAULT_CUDA_VERSION}
TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST:-12.0}      # sm_120 (RTX PRO 6000 Blackwell)
# Memory budget. MAX_JOBS is derived from it because parallel nvcc is what OOMs
# this box (125 GB, no swap): each cicc holds 2-6 GB on the heavy sm120 template
# kernels, so an unbounded 28 jobs can spike past 110 GB. Set MAX_JOBS directly
# to bypass the calculation. ./container/slice-setup enforces the same budget as a
# kernel-level backstop; see "Memory-capped builds" in the README.
#
# 110 rather than 90: a full build was measured at a 89.8 GiB peak, i.e. 0.2 GiB
# under a 90 GiB ceiling. Keep this in step with ./container/slice-setup — the two
# read the same variable, but the slice has to be re-run to pick up a change.
BUILD_MEM_GB=${BUILD_MEM_GB:-110}
# Measured, not estimated: a complete build peaked at 89.8 GiB with 14 jobs =
# 6.4 GB/job. (An earlier 4.9 GB average came from sampling a light stretch of
# the flashinfer AOT stage; per-kernel demand varies enormously, so an average
# taken at the wrong moment underestimates badly.) 6 is used rather than 7 so the
# derivation reproduces the 14 jobs that build actually ran at; it under-predicts
# the peak by ~7%, which MEM_HEADROOM_PCT below absorbs.
MEM_PER_JOB_GB=${MEM_PER_JOB_GB:-6}
# Jobs are sized against a *fraction* of the budget, not the whole thing. Sizing
# them to BUILD_MEM_GB directly makes predicted peak equal the cap by
# construction (18 x 5 GB = 90 GB = the limit), which parks the build on the
# ceiling permanently. The gap absorbs peak skew — jobs don't all crest at once,
# but a few hitting 7.3 GB together would blow a zero-headroom budget.
# At 110G/6GB/80% this yields 14 jobs: the configuration measured at 89.8 GiB
# peak with oom_kill=0. Raising BUILD_MEM_GB alone would also raise MAX_JOBS and
# spend the new headroom on more jobs — move MEM_PER_JOB_GB with it.
MEM_HEADROOM_PCT=${MEM_HEADROOM_PCT:-80}
_jobs_by_mem=$(( BUILD_MEM_GB * MEM_HEADROOM_PCT / 100 / MEM_PER_JOB_GB ))
_jobs_by_cpu=$(( $(nproc) - 4 ))
MAX_JOBS=${MAX_JOBS:-$(( _jobs_by_mem < _jobs_by_cpu ? _jobs_by_mem : _jobs_by_cpu ))}
# Keep this at 1. `nvcc -t` parallelises across arch targets, so with the single
# 12.0 target in TORCH_CUDA_ARCH_LIST it buys ~nothing -- but vLLM *divides* by
# it: setup.py compute_num_jobs() does `num_jobs = max(1, MAX_JOBS //
# NVCC_THREADS)`. At the old 8 that floored MAX_JOBS=14 to `ninja -j 1`, running
# vllm-build's 404 CUDA targets one at a time at ~3% CPU. torch and flashinfer
# use MAX_JOBS directly, so the damage was confined to (and easy to miss in) the
# last stage.
NVCC_THREADS=${NVCC_THREADS:-1}

# The version set (see versions.env). vLLM's wheel hard-pins
# flashinfer-python==X, so the flashinfer ref only ever moves with VLLM_REF;
# ./container/preflight refuses a mismatch.
#
# Snapshot builds (an untagged vLLM commit). `VLLM_REF=main` means the commit
# pinned in VLLM_MAIN_SHA (versions.env), NOT the moving branch tip, with that
# commit's flashinfer / torch / torchvision pins (the VLLM_MAIN_* overrides). Any
# other non-tag ref (a full sha, origin/main, a branch) is taken as given, and
# then FLASHINFER_REF *and* TORCH_REF / TORCHVISION_VERSION must be whatever that
# commit's requirements/cuda.txt pins (preflight refuses otherwise). Snapshots
# get their own tag family (see TAG below) and never move :latest, so ./qwen/run
# and friends keep the release build while ./qwen3.8-flash-next/run finds the
# snapshot by its ai.vllmcustom.vllm.ref label.
VLLM_REF=${VLLM_REF:-$DEFAULT_VLLM_REF}
if [[ $VLLM_REF == main ]]; then
  VLLM_REF=$VLLM_MAIN_SHA
  FLASHINFER_REF=${FLASHINFER_REF:-$VLLM_MAIN_FLASHINFER_REF}
  # main diverged from the release set at vllm#52183 (torch 2.14.0). Inside the
  # branch and ahead of the DEFAULT_* fallbacks below, so an explicit
  # TORCH_REF=... on the command line still wins and the release path is untouched.
  TORCH_REF=${TORCH_REF:-$VLLM_MAIN_TORCH_REF}
  TORCHVISION_VERSION=${TORCHVISION_VERSION:-$VLLM_MAIN_TORCHVISION_VERSION}
fi
# A release is vX.Y.Z; anything else is a snapshot.
if [[ $VLLM_REF =~ ^v[0-9] ]]; then VLLM_SNAPSHOT=0; else VLLM_SNAPSHOT=1; fi
TORCH_REF=${TORCH_REF:-$DEFAULT_TORCH_REF}
FLASHINFER_REF=${FLASHINFER_REF:-$DEFAULT_FLASHINFER_REF}

# Clean PEP 440 versions (strip leading 'v') baked into the wheels so vLLM's
# torch==X pin resolves to our source build instead of pulling from PyPI.
TORCH_VERSION=${TORCH_VERSION:-${TORCH_REF#v}}
# A snapshot has no tag to strip; its version is derived after sync_src below,
# once the commit is checked out (it needs the commit's date and sha).
(( VLLM_SNAPSHOT )) || VLLM_VERSION=${VLLM_VERSION:-${VLLM_REF#v}}
# The release a snapshot of main is heading for (the .dev prefix; see versions.env).
VLLM_NEXT_VERSION=${VLLM_NEXT_VERSION:-$DEFAULT_VLLM_NEXT_VERSION}
FLASHINFER_VERSION=${FLASHINFER_VERSION:-${FLASHINFER_REF#v}}   # prebuilt cubin wheel pin
TORCHVISION_VERSION=${TORCHVISION_VERSION:-$DEFAULT_TORCHVISION_VERSION}
TORCHAUDIO_REF=${TORCHAUDIO_REF:-$DEFAULT_TORCHAUDIO_REF}
TORCHAUDIO_VERSION=${TORCHAUDIO_VERSION:-${TORCHAUDIO_REF#v}}
# torchvision stays a prebuilt wheel, from the CUDA-minor-matched index
# (13.2.1 -> cu132). Preflight verifies the wheel exists before anything compiles.
_cu_minor=${CUDA_VERSION%.*}                            # 13.2.1 -> 13.2
TORCHVISION_INDEX=${TORCHVISION_INDEX:-cu${_cu_minor//./}}

IMAGE=${IMAGE:-iphands/vllm-blackwell}
CUDA_TAG=${CUDA_VERSION//./}                            # 13.0.3 -> 1303
# $TAG is the moving "newest build of this CUDA variant" tag; $VTAG (set after
# sync_src, once VLLM_VERSION is known) pins the vLLM version so `docker images`
# says which vLLM an image actually carries. Snapshots live under a -main suffix
# of their own so they never shadow the release build. ./container/push derives
# its tags from the image's labels, not from these — see ./container/push.
if (( VLLM_SNAPSHOT )); then
  TAG=${TAG:-cu${CUDA_TAG}-sm120-main}
else
  TAG=${TAG:-cu${CUDA_TAG}-sm120}
fi

BUILD_DIR=${BUILD_DIR:-/mnt/noir/scratch/ai/vllm/build}
SRC_DIR="$BUILD_DIR/src"
CTX_DIR=${CTX_DIR-$BUILD_DIR/ctx}                       # EMPTY = contexts straight from $SRC_DIR
# -----------------------------------------------------------------------------

# --- refuse a root run, then prove every path and the socket -------------------
# MUST STAY ABOVE THE FIRST WRITE (`mkdir -p "$SRC_DIR"` below) and above the socket
# probe: past those, failures are paid for in minutes, in hours, or — for the four trees
# under $SRC_DIR — irrecoverably.
#
# No escape hatch, same as the launcher guard in common/_run-lib.sh. Plan 02 removed the one
# this had (ALLOW_ROOT): it silenced the check without changing the damage, and a flag that
# now silently does nothing is worse than a refusal — whoever exports it believes it is doing
# something. Set it and this says so out loud. The check itself STAYS: _writable below cannot
# stand in for it, because _writable tests `-w` and root is writable by definition, so a
# privileged run passes every one of those checks on its way to ruining the four trees.
if [[ ${ALLOW_ROOT+set} == set ]]; then
  printf '## ALLOW_ROOT no longer does anything: this project has no root machinery.\n' >&2
  printf '##   Remove it from your env or CI. Continuing as uid %s without it.\n' "$EUID" >&2
fi
if [[ $EUID == 0 ]]; then
  {
    printf '## REFUSED: running as root. Run it as yourself:\n'
    printf '##     %s\n' "$0"
    printf '##   why: this git-fetches and "checkout --force"s the four hand-editable trees under\n'
    printf '##   %s. They are hand-editable by design; as root they land root-owned and the next\n' "$SRC_DIR"
    printf '##   unprivileged run cannot touch them — half-way through a checkout that is unrecoverable.\n'
    printf '##   this script needs no privilege to run: it calls docker directly, as you.\n'
    if [[ -n $CTX_DIR ]]; then
      printf '##   it also rsyncs staged contexts into %s (same ownership problem).\n' "$CTX_DIR"
    else
      printf '##   CTX_DIR is empty, so no staged copies are made: the source trees above are all\n'
      printf '##   this run writes to.\n'
    fi
    printf '##\n'
    printf '##   if a privileged build already left damage here, the next unprivileged run prints\n'
    printf '##   what is actually runnable: su -c chown, mv the tree aside, or relocate BUILD_DIR=.\n'
  } >&2
  exit 1
fi

# Same contract as common/_run-lib.sh: a plain string, split on spaces, defaulting to plain
# `docker`. This project uses no privilege helper; DOCKER exists so an operator can point it at
# a wrapper. The three guard predicates are byte-identical to common/_run-lib.sh and container/archs on
# purpose (the message blocks differ only in echo vs printf).
#
# `@a` answers with attribute FLAGS, not a type letter. Measured on bash 5.2: an exported
# plain string reports `x`, a shell-local one reports nothing, an indexed array reports
# `a`, an exported one `ax`. So a truthiness test on ${DOCKER@a} — or `== a`, which is what
# this guard shipped as in T1 — is wrong in both directions: it rejects every
# `DOCKER=docker` that arrives from the environment (the only way anyone sets it), and it
# misses an exported array. Test for an a/A anywhere in the flags.
if [[ -n ${DOCKER+set} && ${DOCKER@a} == *[aA]* ]]; then
  echo "## DOCKER must be a plain string (DOCKER=docker), not an array." >&2
  exit 1
fi
IFS=' ' read -r -a DOCKER <<< "${DOCKER:-docker}"
if (( ${#DOCKER[@]} == 0 )); then
  echo "## DOCKER is set but holds no words; use DOCKER=docker or unset it." >&2
  exit 1
fi
# Refuse a DOCKER that names sudo, per word. The glob must be CONTAINED (`*'/sudo '*`), not
# end-anchored: the operand is padded with a trailing space, so `== */sudo` cannot match any input
# at all — measured 2026-10-13, that arm was dead in all three copies and let `DOCKER=/usr/bin/sudo`
# through. Containment also catches sudo as a non-final word. A wrapper legitimately named
# /opt/sudo-docker/bin/docker still passes, because what follows its "sudo" is "-", not a space.
# Refused rather than obeyed: with no sudo installed the value fails at exit 127 and the probe
# below would report "DOCKER points at nothing", pointing at a perfectly good `docker`.
if [[ ' '"${DOCKER[*]}"' ' == *' sudo '* || ' '"${DOCKER[*]}"' ' == *'/sudo '* ]]; then
  {
    printf '## DOCKER names '"'"'sudo'"'"'. This project does not use it — nothing here needs a privilege helper.\n'
    printf '##   fix:    unset DOCKER      (the default is plain '"'"'docker'"'"')\n'
    printf '##   wrapper? name it directly: DOCKER=/usr/local/bin/my-docker\n'
  } >&2
  exit 1
fi

# Root-owned leftovers: full builds here ran privileged before Plan 01, so the paths this run
# writes may be root-owned. Found mid-flight that is EACCES minutes into a fetch, or at the very
# LAST line, when .last-build is written after a build that already succeeded. So prove them
# first. A path that does not exist yet is gated by its nearest existing ANCESTOR — that is where
# $BUILD_DIR's ownership actually hides.
_writable() {   # $1 = path this run writes, $2 = what lives there, $3 = remedy: chown|rm|rmf
  local probe=$1 kind=$3 owner
  # Absolute BEFORE the walk. `${x%/*}` on a slash-less component returns it UNCHANGED, so a
  # relative BUILD_DIR=/CTX_DIR= pointing at something that does not exist yet never
  # shortens and the loop below spins forever — a hung terminal with no output at the front
  # door, the exact failure this block exists to prevent. (Any relative path hangs once it
  # reaches its last slash-less component, not just single-word ones.) $PWD-prefixing also
  # makes the path printed unambiguous. Measured: BUILD_DIR=build ./container/build hangs
  # without this line; every absolute path terminates at `/` regardless.
  [[ $probe == /* ]] || probe=$PWD/$probe
  while [[ ! -e $probe && $probe != / ]]; do
    probe=${probe%/*}
    [[ -n $probe ]] || probe=/
  done
  if [[ -w $probe ]]; then return 0; fi     # explicit `if`: a trailing `&&` would make this
                                            # function return 1 and errexit the caller
  owner=$(stat -c '%u' "$probe" 2>/dev/null || echo '?')
  {
    printf '## REFUSED: %s is not writable by uid %s.\n' "$2" "$EUID"
    printf '##   %s is owned by uid %s.\n' "$probe" "$owner"
    # Say the cause only when the evidence is the cause. uid 0 means a privileged run
    # (pre-Plan-01, or someone reaching this script via su); anything else is a mode problem or a
    # mistyped override, and calling that a leftover sends the reader to fix nothing.
    if [[ $owner == 0 ]]; then
      printf '##   owned by root — written by a privileged run, before this project stopped needing one.\n'
    else
      printf '##   not a root leftover: a mode problem, or a mistyped BUILD_DIR/CTX_DIR.\n'
    fi
    [[ $1 == "$probe" ]] \
      || printf '##   %s does not exist yet — the gate is its parent, so the fix below names the parent.\n' "$1"
    # The remedy names $probe, never $1. `chown -R` on a path that is not there fails with
    # "cannot access", and owning the parent IS the fix: mkdir/rsync then recreate the leaf with
    # correct ownership. Every branch below states what an operator with NO privilege can actually
    # run, because that is the only kind this project has — printing an unrunnable "one-time fix"
    # is worse than printing none, and printing a destructive one that only half-works is worse
    # than both. Hence: no chown you cannot perform, and no `rm -rf` into a root-owned tree.
    case $kind in
      chown)
        # Hand-editable or irreplaceable, so there is no privilege-free fix. Say that first
        # instead of implying one, then rank: keep-the-tree, move-it-aside, relocate.
        printf '##   no privilege on this box, so nothing you run as yourself can take it. Pick one:\n'
        printf '##     a) with root:  su -c "chown -R %s:%s -- %q"\n' "$(id -u)" "$(id -g)" "$probe"
        printf '##     b) rename it aside — a rename needs write on the PARENT only, so it works:\n'
        printf '##        mv -- %q %q.uid%s\n' "$probe" "$probe" "$owner"
        printf '##     c) relocate: BUILD_DIR= a path you own.\n'
        printf '##   CAREFUL with b) and c) on a source tree: hand-editable by design. Look first:\n'
        printf '##     git -C %q status --short\n' "$probe"
        ;;
      rm)
        # Regenerable staging — but `rm -rf` into a root-owned 0755 leaf fails partway, because
        # unlinking inside a directory needs write ON THAT DIRECTORY. A rename needs the parent
        # only, so mv always succeeds where rm cannot. Never print rm -rf for this class.
        printf '##   regenerable staging, but root-owned inside, so rm -rf would fail partway.\n'
        printf '##   rename it aside instead — write on the parent is enough, and the rsync\n'
        printf '##   below recreates it owned by you:\n'
        printf '##     mv -- %q %q.uid%s\n' "$probe" "$probe" "$owner"
        printf '##   or relocate the whole staging root with CTX_DIR= (CTX_DIR= disables staging).\n'
        ;;
      rmf)
        # The one remedy that genuinely needs no privilege: unlink is governed by write on the
        # DIRECTORY, not by the file's own owner. Keep this branch copy-pasteable.
        printf '##   one-step fix, no privilege needed:\n'
        printf '##     rm -f -- %q\n' "$probe"
        ;;
    esac
  } >&2
  exit 1
}

_writable "$SRC_DIR" 'the source tree root' chown
for _tree in pytorch flashinfer vllm torchaudio; do
  # $SRC_DIR writable does NOT imply its children are: a mixed tree (you made the top level, a
  # later privileged run made the clone) is exactly the case that abandons a `checkout --force`
  # half-finished. These four trees are the thing RULES.md calls unrecoverable.
  if [[ -e "$SRC_DIR/$_tree" ]]; then
    _writable "$SRC_DIR/$_tree" "the $_tree source tree" chown
  fi
done
if [[ -n $CTX_DIR ]]; then
  # The ROOT gets the chown class, never the rm class. `%q` quotes a token, not a SCOPE: a
  # mistyped CTX_DIR=/mnt/noir/scratch/ai/vllm (the `/ctx` tail dropped) is root-owned enough to
  # trip this check, and the rm class prints a pasteable recursive delete. Removing the privilege
  # helper makes that command EASIER to run, not harder — no password stands between the paste and
  # the damage — so the root of anything that can contain $SRC_DIR must never be offered for
  # deletion. chown/mv/relocate is safe here and sufficient: own the directory and the rsync below
  # reconciles the rest. The four leaves below have names this script chose, so the rm class is
  # bounded there, and moving regenerable staging aside beats chowning gigabytes of it.
  _writable "$CTX_DIR" 'the staged-context root' chown
  for _ctx in pytorch flashinfer vllm torchaudio; do
    if [[ -e "$CTX_DIR/$_ctx" ]]; then
      _writable "$CTX_DIR/$_ctx" "the staged $_ctx context" rm
    fi
  done
fi
_writable "$here/.last-build" 'container/.last-build' rmf

# Prove dockerd answers before anything here is paid for — the same probe and the same reasoning
# common/_run-lib.sh already applies to the launchers. Without it a dead socket surfaces at the
# `docker build` line: after four `checkout --force`s have mutated the trees RULES.md calls
# unrecoverable, and after GB of context crossed NFS.
# Runs even under PREFLIGHT_ONLY, which costs ~0.1 s and still never invokes a build.
_probe_rc=0
_docker_probe=$(timeout 15 "${DOCKER[@]}" version 2>&1) || _probe_rc=$?
if (( _probe_rc != 0 )); then
  {
    printf '## docker is not reachable via %s — stopping before anything is written.\n' "${DOCKER[*]}"
    # tail, never `| head`: the SIGPIPE / pipefail / exit-141 trap documented at
    # common/_run-lib.sh:92. Do not "simplify" this into a pipeline.
    tail -3 <<<"$_docker_probe" | sed 's/^/##   it said: /'
    printf '##   reproduce it:  %s version\n' "${DOCKER[*]}"
    # The exit code already says which failure this is, so state it instead of handing the
    # reader a lookup table against the echo above. `if (( ))` is errexit-safe; a bare
    # `(( ))` here would abort the script on its own false branch.
    if (( _probe_rc == 124 )); then
      printf '##   exit 124: killed at the 15 s limit — dockerd is wedged.\n'
    elif (( _probe_rc == 127 )); then
      printf '##   exit 127: %s is not a runnable command — DOCKER points at nothing.\n' "${DOCKER[0]}"
      printf '##   fix: unset DOCKER   (the default is plain '"'"'docker'"'"')\n'
    elif grep -qi 'permission denied' <<<"$_docker_probe"; then
      printf '##   you may not open the socket. Read who can, do not guess a group name:\n'
      printf "##     stat -c '%%U:%%G %%a' /var/run/docker.sock\n"
      printf '##   nothing in this project fixes that with a privilege helper; it is host-side.\n'
    else
      printf "##   'Cannot connect' -> dockerd is not running.\n"
    fi
    printf '## nothing was written by this run; your source trees are untouched.\n'
  } >&2
  exit 1
fi
# One greppable identity line: "what did that log actually run against" should be a single
# grep of a build log, not a re-read of the script.
echo "## pre-write checks pass: every target writable · uid=$EUID docker=${DOCKER[*]} BUILD_DIR=$BUILD_DIR"

mkdir -p "$SRC_DIR" || {
  printf '## cannot create %s: it does not exist and uid %s cannot make it.\n' "$SRC_DIR" "$EUID" >&2
  printf '##   fix: take its parent, or point BUILD_DIR= at a tree you own.\n' >&2
  exit 1
}

# Clone-once / fetch-and-checkout helper. $1=name $2=url $3=ref
sync_src() {
  local name=$1 url=$2 ref=$3
  local dir="$SRC_DIR/$name"
  if [[ ! -d "$dir/.git" ]]; then
    echo "## cloning $name ($ref)"
    git clone --recursive "$url" "$dir"
  fi
  echo "## syncing $name -> $ref"
  git -C "$dir" fetch --tags --force origin
  git -C "$dir" checkout --force "$ref"
  git -C "$dir" submodule update --init --recursive --depth 1
}

sync_src pytorch    https://github.com/pytorch/pytorch.git        "$TORCH_REF"
sync_src flashinfer https://github.com/flashinfer-ai/flashinfer.git "$FLASHINFER_REF"
sync_src vllm       https://github.com/vllm-project/vllm.git        "$VLLM_REF"
sync_src torchaudio https://github.com/pytorch/audio.git             "$TORCHAUDIO_REF"

# Snapshot wheel version: <next release>.dev<commit date>+g<sha7> -- PEP 440, in
# the shape of upstream's nightlies, so `vllm --version` inside the image says
# which commit is running. The date sorts, the sha identifies. Docker tags cannot
# carry the '+', so $VTAG (and ./container/push) turn it into '-'.
if (( VLLM_SNAPSHOT )); then
  _vllm_sha7=$(git -C "$SRC_DIR/vllm" rev-parse --short=7 HEAD)
  _vllm_date=$(git -C "$SRC_DIR/vllm" show -s --format=%cd --date=format:%Y%m%d HEAD)
  VLLM_VERSION=${VLLM_VERSION:-"${VLLM_NEXT_VERSION}.dev${_vllm_date}+g${_vllm_sha7}"}
fi
VTAG="${TAG}-vllm${VLLM_VERSION//+/-}"

# Fail fast on an incompatible version set. This is host-side only — it never
# runs `docker build`, so it cannot invalidate a layer. Worth the second: a
# flashinfer/vLLM mismatch is otherwise only discovered by the final
# `uv pip install /wheels/*.whl`, after the ~35min AOT recompile.
# PREFLIGHT_ONLY=1 stops here; ALLOW_VERSION_MISMATCH=1 downgrades it to a warning.
echo
SRC_DIR="$SRC_DIR" VLLM_REF="$VLLM_REF" \
TORCH_VERSION="$TORCH_VERSION" FLASHINFER_VERSION="$FLASHINFER_VERSION" \
TORCHVISION_VERSION="$TORCHVISION_VERSION" TORCHAUDIO_VERSION="$TORCHAUDIO_VERSION" \
TORCHVISION_INDEX="$TORCHVISION_INDEX" \
  "$here/preflight"
if [[ ${PREFLIGHT_ONLY:-0} == 1 ]]; then
  echo "## PREFLIGHT_ONLY=1 — stopping before docker build."
  exit 0
fi

# Build contexts without .git. The Dockerfile's COPY --exclude=.git keeps it out
# of the layers and cache keys, but BuildKit still transfers the whole context
# first, and only the context's own .dockerignore filters that (pytorch's is a
# symlink to .gitignore, which does not list .git). Measured: pytorch's context
# was 7.57 GB, 6.0 GB of it .git (4.3 GB of that is submodule history), and all
# of it was re-read over NFS on every build, even a fully cached one. A copy
# holds exactly the files those COPYs already took, so their cache keys (and the
# multi-hour torch layer) are unchanged. rsync only re-copies what the sync changed.
if [[ -n $CTX_DIR ]]; then
  echo
  echo "## staging build contexts without .git in $CTX_DIR"
  for _ctx in pytorch flashinfer vllm torchaudio; do
    mkdir -p "$CTX_DIR/$_ctx"
    rsync -a --delete --exclude=.git "$SRC_DIR/$_ctx/" "$CTX_DIR/$_ctx/"
  done
  CTX_ROOT=$CTX_DIR
else
  CTX_ROOT=$SRC_DIR
fi

# Hard memory ceiling for the RUN steps. `docker buildx build` has no --memory
# (classic-builder only); --cgroup-parent is the supported mechanism, and the
# BuildKit embedded in dockerd does honor it (verified: RUN steps land in
# /sys/fs/cgroup/$CGROUP_PARENT/buildkit/).
#
# Read memory.max out of the live cgroup rather than asking systemctl for the
# unit's configured value. BuildKit *creates* the cgroup itself — uncapped — if
# it doesn't exist, so a unit file that was never `systemctl start`ed reports a
# healthy 110G from systemctl while the actual build runs unlimited. The kernel
# state is the only honest answer. Missing/uncapped warns but never fails; the
# derived MAX_JOBS still applies.
#
# Resolve the path via ControlGroup instead of assuming /sys/fs/cgroup/$SLICE:
# systemd reads '-' in a slice name as a hierarchy separator, so vllm-build.slice
# would actually live at /sys/fs/cgroup/vllm.slice/vllm-build.slice. BuildKit
# treats --cgroup-parent as a literal path, so it must get the resolved path
# (leading / stripped) or it would mkdir a fresh uncapped cgroup at the top level.
CGROUP_PARENT=${CGROUP_PARENT:-vllmbuild.slice}
cgroup_args=()
cgroup_path=$(systemctl show "$CGROUP_PARENT" --property=ControlGroup --value 2>/dev/null || true)
live_max=$(cat "/sys/fs/cgroup$cgroup_path/memory.max" 2>/dev/null || true)
if [[ -n $cgroup_path && $live_max =~ ^[0-9]+$ ]]; then
  cgroup_args=(--cgroup-parent="${cgroup_path#/}")
  # The slice does not track BUILD_MEM_GB automatically — slice-setup has to be
  # re-run. Warn on disagreement: a slice capped lower than the budget MAX_JOBS
  # was derived from is how you get an OOM kill from a build that looks correctly
  # sized. Warn only; the cap is real either way and the build is still safe.
  want_max=$(( BUILD_MEM_GB * 1024 * 1024 * 1024 ))
  if [[ $live_max -ne $want_max ]]; then
    echo "## WARN: $CGROUP_PARENT is capped at $(( live_max / 1024 / 1024 / 1024 ))G"
    echo "##       but MAX_JOBS=$MAX_JOBS was derived from BUILD_MEM_GB=${BUILD_MEM_GB}G."
    echo "##       Re-sync:  BUILD_MEM_GB=$BUILD_MEM_GB su -c '$here/slice-setup'"
  fi
else
  echo "## WARN: $CGROUP_PARENT is missing or uncapped — no hard ceiling on this build."
  echo "##       Install it once:  su -c '$here/slice-setup'"
  echo "##       Proceeding with MAX_JOBS=$MAX_JOBS as the only limit."
fi

# Build-speed knobs travel as a secret, not --build-arg. BuildKit keeps secret
# contents out of the cache key, so retuning MAX_JOBS reuses the cached compile
# layers instead of forcing a full torch+flashinfer+vllm rebuild (which is what
# ARG/ENV did). Correct as well as convenient: these change build speed, never
# the artifact. The banner below stays the record of what a build actually ran
# with, since the values no longer appear anywhere in the image.
jobs_file=$(mktemp)
trap 'rm -f "$jobs_file"' EXIT
printf 'MAX_JOBS=%s\nNVCC_THREADS=%s\n' "$MAX_JOBS" "$NVCC_THREADS" > "$jobs_file"

echo
# :latest is the release build's alias only; a snapshot must not take it over.
tag_args=(-t "$IMAGE:$TAG" -t "$IMAGE:$VTAG")
if (( VLLM_SNAPSHOT )); then
  echo "## SNAPSHOT build of vLLM $VLLM_REF (wheel version $VLLM_VERSION); :latest is left alone."
else
  tag_args+=(-t "$IMAGE:latest")
fi
echo "## building $IMAGE:$TAG  (cuda=$CUDA_VERSION torch=$TORCH_REF flashinfer=$FLASHINFER_REF vllm=$VLLM_REF torchaudio=$TORCHAUDIO_REF arch=$TORCH_CUDA_ARCH_LIST mem=${BUILD_MEM_GB}G jobs=$MAX_JOBS)"

# `DOCKER_BUILDKIT=1` is pinned here, and the reason for pinning it INVERTED when Plan 02 dropped
# the privilege helper. The prefix used to be pointless: sudo's env_reset stripped the variable
# before the CLI ever saw it, so every build here ran on the daemon default and the flag could not
# mean anything. With DOCKER defaulting to plain `docker` nothing strips it any more, so a stray
# `export DOCKER_BUILDKIT=0` in a profile or CI image now reaches the CLI and selects the LEGACY
# builder. Observed on this dockerd (29.7.2): `DOCKER_BUILDKIT=0 docker build` answers "DEPRECATED:
# The legacy builder is deprecated" and cannot read the Dockerfile at all — and this line sits BELOW
# four `checkout --force`s and GB of staged context, so that is the worst possible place to discover
# it. Pinning costs nothing and makes the one flag mean one thing on every host.
env DOCKER_BUILDKIT=1 "${DOCKER[@]}" build \
  ${cgroup_args[@]+"${cgroup_args[@]}"} \
  -f "$here/Dockerfile" \
  --build-context pytorch="$CTX_ROOT/pytorch" \
  --build-context flashinfer="$CTX_ROOT/flashinfer" \
  --build-context vllm="$CTX_ROOT/vllm" \
  --build-context torchaudio="$CTX_ROOT/torchaudio" \
  --build-arg CUDA_VERSION="$CUDA_VERSION" \
  --build-arg TORCH_CUDA_ARCH_LIST="$TORCH_CUDA_ARCH_LIST" \
  --build-arg TORCH_VERSION="$TORCH_VERSION" \
  --build-arg VLLM_VERSION="$VLLM_VERSION" \
  --build-arg VLLM_REF="$VLLM_REF" \
  --build-arg FLASHINFER_VERSION="$FLASHINFER_VERSION" \
  --secret id=buildjobs,src="$jobs_file" \
  --build-arg TORCHVISION_VERSION="$TORCHVISION_VERSION" \
  --build-arg TORCHAUDIO_VERSION="$TORCHAUDIO_VERSION" \
  --build-arg TORCHVISION_INDEX="$TORCHVISION_INDEX" \
  --target vllm-openai \
  "${tag_args[@]}" \
  "$here"

echo
if (( VLLM_SNAPSHOT )); then
  echo "## built $IMAGE:$TAG (also tagged :$VTAG; :latest untouched)"
else
  echo "## built $IMAGE:$TAG (also tagged :$VTAG and :latest)"
fi

# What ./container/push publishes by default: the image this run just built, so
# `VLLM_REF=main ./container/build && ./container/push` pushes the snapshot
# rather than whatever :latest happens to be. Written only on success (set -e);
# gitignored, machine-local state.
printf 'IMAGE=%s\nTAG=%s\nVTAG=%s\nVLLM_REF=%s\n' "$IMAGE" "$TAG" "$VTAG" "$VLLM_REF" > "$here/.last-build"
echo "## recorded in container/.last-build -- ./container/push will publish $IMAGE:$TAG"
