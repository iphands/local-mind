# Version pins for the vllmcustom image -- the ONE place they live.
#
# Read by ./container/build (what to build), ./container/push (stale-snapshot
# check) and ./qwen3.8-flash-next/run (which image to run). Plain KEY=value only:
# comments on their own lines, no quotes, no $expansions, no trailing comments,
# so it is valid both for bash `source` and for `docker run --env-file`.
#
# DEFAULT_* names are defaults, not settings: ./container/build reads them as
# ${CUDA_VERSION:-$DEFAULT_CUDA_VERSION} etc., so `CUDA_VERSION=13.0.3
# ./container/build` still overrides without editing this file.
#
# Bumping the main snapshot:
#   1. set VLLM_MAIN_SHA to the new commit, and VLLM_MAIN_FLASHINFER_REF to what
#      that commit's requirements/cuda.txt pins (flashinfer-python==X -> vX)
#   2. PREFLIGHT_ONLY=1 VLLM_REF=main ./container/build   # seconds; refuses a mismatch
#   3. VLLM_REF=main ./container/build && ./container/push
#   4. ./qwen3.8-flash-next/run                           # finds the new image by its vllm.ref label
# Nothing else needs editing unless the build or the launcher tells you so (the
# PLE overlay checks its upstream file by content: patches/ple-ct-ignore/UPSTREAM).

# 13.2.1 = newest toolkit torch 2.13.0 officially builds against (binary matrix
# 12.6/12.9/13.0/13.2). 13.3.x is published and the host driver (610.43.03) meets
# its 610.43.02 floor, but no torch/flashinfer/vLLM release has CI on 13.3 yet,
# and flashinfer notes 13.3+ nvcc changed its dry-run output (broke sccache).
# vLLM itself only CI-builds on 13.0.3, so that is the safe fallback variant.
DEFAULT_CUDA_VERSION=13.2.1

# Release set: mutually compatible (vLLM v0.29.0 pins torch 2.13.0 / flashinfer
# 0.6.18 -- see its requirements/cuda.txt; ./container/preflight checks this).
# Not bumped further on purpose (2026-09-11): torch 2.14.0 is out but no vLLM
# release pins it, and vLLM's wheel hard-pins flashinfer-python==X, so the
# flashinfer ref can only move together with the vLLM ref.
DEFAULT_VLLM_REF=v0.29.0
DEFAULT_TORCH_REF=v2.13.0
DEFAULT_FLASHINFER_REF=v0.6.18
# torchaudio is built from source (pytorch/audio). 2.11.0 is upstream's pairing
# with torch 2.13.0 -- and there is no cu132 torchaudio wheel, while a cu130 one
# refuses to import next to a CUDA 13.2 torch (both torchaudio and torchvision
# compare CUDA major.minor at import). So: source build, against our torch.
DEFAULT_TORCHAUDIO_REF=v2.11.0
# torchvision stays a prebuilt wheel, from the CUDA-minor-matched index.
DEFAULT_TORCHVISION_VERSION=0.28.0

# Main snapshot (VLLM_REF=main ./container/build): the commit pinned here, NOT
# the moving branch tip -- bump it deliberately so a build can be reproduced and
# its flashinfer pin re-checked. Snapshots get their own tag family
# (cu<cuda>-sm120-main...) and never move :latest.
# main @ 2026-09-24 (was 826e300, 2026-09-22): torch 2.13.0 / flashinfer 0.7.0.
VLLM_MAIN_SHA=36f94d5fe8a3953f1ad340de3c5aaec909765243
VLLM_MAIN_FLASHINFER_REF=v0.7.0
# The release a snapshot of main is heading for. Cosmetic: it only prefixes the
# .dev version and nothing compares it. Bump when a new vX.Y.0 is cut.
# 0.31.0 since 2026-09-18: v0.30.0 sits on a release branch cut from main at
# f2aad6aa70 (2026-09-15), and the snapshots are past that point, so a
# 0.30.0.dev version would sort *below* a release it is ahead of.
DEFAULT_VLLM_NEXT_VERSION=0.31.0
