# The b12x pin -- read by ./container/patches/b12x/fetch and by b12x_args in
# common/_run-lib.sh. Same shape rule as container/versions.env: plain KEY=value,
# comments on their own lines, no quotes, no $expansions, no trailing comments.
#
# 1.5.1 is what vLLM pins for its "b12x" extra at VLLM_MAIN_SHA 4d9a8d6
# (setup.py:1709). Move it together with a repin, never on its own: vLLM imports
# private b12x modules (b12x._lib.intrinsics, see vllm/utils/b12x.py).
# Values from https://pypi.org/pypi/b12x/1.5.1/json (2026-10-16).
B12X_VERSION=1.5.1
B12X_WHEEL=b12x-1.5.1-py3-none-any.whl
B12X_WHEEL_URL=https://files.pythonhosted.org/packages/0c/7f/31fbc8311188835a509d97c38f6400071ba5b01a5ca54cb33d7b22dec3fa/b12x-1.5.1-py3-none-any.whl
B12X_WHEEL_SHA256=8731e23571d8d45db26d78e7699ec0b23e7ba20b52487adf8c1063c8d8b53a3d
