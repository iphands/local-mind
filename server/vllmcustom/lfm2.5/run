#!/bin/bash
# Serve LFM2.5-24B-A2B (Liquid AI; 24B MoE, 2.45B active) on the ONE RTX PRO 6000 from OUR
# sm120 main-snapshot image, tuned for single-stream decode.
#
#   VLLM_REF=main ./container/build                # build the snapshot first (the VLLM_MAIN_SHA pinned in container/versions.env)
#   ./lfm2.5/run                                   # primitive-ai/LFM2.5-24B-A2B-NVFP4A16 (default; humming MoE)
#   ./lfm2.5/run <path-or-name>                    # another Lfm2Moe checkpoint under models/vllm
#
# THE CHECKPOINT (primitive-ai/LFM2.5-24B-A2B-NVFP4A16, 14.95 GB)
#
# compressed-tensors nvfp4-pack-quantized, WEIGHT-ONLY (input_activations null = "A16"):
# only the routed experts are NVFP4 (E2M1, E4M3 scale per 16, calibrated). Attention, the
# short-conv blocks, dense layers 0 and 1, embeddings, router and lm_head stay BF16. The card
# measured it on vLLM 0.31.0, stock, sm_120, with a 32K window; this image is a main snapshot, so
# what follows is read from the source, not yet from a boot (see the plan, context/plans/07_*).
#   - Architecture: Lfm2MoeForCausalLM, in the registry. 40 layers: 30 double-gated short-conv
#     blocks (no KV cache; a 3-wide conv state) + 10 GQA blocks. So the KV cache is tiny and a token's
#     bytes are dominated by weights: ~2.45B active, of which the NVFP4 experts are the small part.
#   - MoE: CompressedTensorsW4A4Nvfp4MoEMethod(use_a16=True) -> select_nvfp4_moe_backend. HUMMING and
#     MARLIN are both in its candidate list and both handle the A16 form. Humming is the default here,
#     as on every MoE launcher in this repo; MOE_BACKEND=marlin is the A/B (MOE_BACKEND= = vLLM's pick).
#   - No MTP head and no draft model ship with it (Liquid's DSpark drafter is SGLang-only, "coming
#     soon"), so MTP is not an option. SPEC_TOKENS>0 turns on n-gram prompt lookup, off by default:
#     the short-conv layers carry recurrent state, and n-gram speculation on such a hybrid is UNVERIFIED.
#   - Reasoning: the model ALWAYS thinks (the chat template opens a <think>), so agentic turns need a
#     generous max_tokens. Parsers: --reasoning-parser qwen3 (the card's), --tool-call-parser lfm2
#     (vllm/tool_parsers/lfm2_tool_parser.py: the Python-style list between <|tool_call_start|> markers).
#   - Sampling: Liquid's recommendation (temperature 0.1, top_k 50, repetition_penalty 1.05; also the
#     checkpoint's generation_config.json). Passed explicitly so a vLLM default change cannot move it.
#
# Knobs:
#   MOE_BACKEND=marlin / MOE_BACKEND= ...          # force another NVFP4 MoE backend / auto (default humming)
#   NVFP4_BACKEND=... ...                          # --linear-backend; unused here (no NVFP4 dense layers), EMPTY by default
#   SPEC_TOKENS=3 ./lfm2.5/run                     # n-gram speculation, that many draft tokens (default 0 = off; UNVERIFIED, see above)
#   SPEC_LOOKUP_MAX=4 SPEC_LOOKUP_MIN=2 ...        # n-gram prompt_lookup_max / min (only with SPEC_TOKENS>0)
#   KV_FP8=1 ...                                   # --kv-cache-dtype fp8 (default 0: the card only measured BF16, and 10 attention layers make the pool small anyway)
#   TEMPERATURE=0.1 TOP_K=50 REP_PENALTY=1.05 ...  # the default sampling, Liquid's
#   CUDAGRAPH_MODE=FULL_AND_PIECEWISE ...          # full CUDA graphs (A/B, default EMPTY = vLLM's choice)
#   FLASHINFER_AUTOTUNE=1 ...                      # FlashInfer autotuning during warmup (A/B)
#   ATTN_BACKEND=flashinfer ...                    # default EMPTY = let vLLM pick
#   GPU_MEM_UTIL=0.90 MAX_NUM_SEQS=8 MAX_MODEL_LEN=131072 MAX_BATCHED_TOKENS=8192 ...
#                                                  # MAX_MODEL_LEN is the model's native window; the card tested only 32768
#   BOOT_TIMING=0 ...                              # do NOT mount container/patches/boot-timing (startup waterfall report)
#   IMAGE_TAG=cu1321-sm120-main ...                # the MOVING snapshot tag instead of the VLLM_MAIN_SHA lookup
#   IMAGE=... ENV_EXTRA=... EXTRA_ARGS=...         # as everywhere else
#
# Benchmark against the running server: ./bench/bench <label>
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=../common/_run-lib.sh
source "$HERE/../common/_run-lib.sh"

# shellcheck disable=SC2034  # read by docker_core_args in common/_run-lib.sh
NAME=vllm
# Same image pinning as qwen3.8-flash-next/run: the main snapshot built from VLLM_MAIN_SHA, found
# by its ai.vllmcustom.vllm.ref label, never :latest (the release build).
# shellcheck source-path=SCRIPTDIR source=../container/versions.env
source "$HERE/../container/versions.env"
IMAGE=${IMAGE:-iphands/vllm-blackwell}
if [[ -z ${IMAGE_TAG:-} ]]; then
  IMAGE_TAG=$("${DOCKER[@]}" images "$IMAGE" --filter "label=ai.vllmcustom.vllm.ref=$VLLM_MAIN_SHA" \
                --format '{{.Tag}}' | grep -m1 "^cu${DEFAULT_CUDA_VERSION//./}-sm120-main-vllm" || true)
  if [[ -z $IMAGE_TAG ]]; then
    echo "No $IMAGE image built from vLLM $VLLM_MAIN_SHA (VLLM_MAIN_SHA in container/versions.env)."
    echo "Build the main snapshot first:"
    echo "  VLLM_REF=main ./container/build"; exit 1
  fi
fi
vllm_image

# shellcheck disable=SC2034  # read by resolve_model in common/_model-lib.sh
DEFAULT_MODEL=primitive-ai/LFM2.5-24B-A2B-NVFP4A16   # relative to MODEL_ROOT (./models/vllm)
resolve_model "${1:-}"

# Refuse anything that is not an Lfm2 checkpoint: the parsers and sampling below are LFM's.
python3 - "$MODEL_ROOT/$MODEL" <<'PY' || { echo "model check failed: $MODEL is not an Lfm2 checkpoint"; exit 1; }
import json, pathlib, sys
cfg = json.load(open(pathlib.Path(sys.argv[1]) / "config.json"))
archs = cfg.get("architectures", [])
if not any(a.startswith("Lfm2") for a in archs):
    sys.exit(f"architectures={archs}")
q = cfg.get("quantization_config") or {}
print(f"## model  {archs[0]}  quant={q.get('quant_method', 'none')}/{q.get('format', '-')}")
PY

PORT=${PORT:-8700}
ATTN_BACKEND=${ATTN_BACKEND-}                    # EMPTY = vLLM auto-select
MOE_BACKEND=${MOE_BACKEND-humming}               # EMPTY = auto; marlin = the A/B
NVFP4_BACKEND=${NVFP4_BACKEND-}                  # no NVFP4 dense layers in this checkpoint
SPEC_TOKENS=${SPEC_TOKENS:-0}                    # n-gram draft tokens; 0 = off
SPEC_LOOKUP_MAX=${SPEC_LOOKUP_MAX:-4}
SPEC_LOOKUP_MIN=${SPEC_LOOKUP_MIN:-2}
KV_FP8=${KV_FP8-0}                               # 1 = --kv-cache-dtype fp8
TEMPERATURE=${TEMPERATURE:-0.1}                  # Liquid's recommended sampling
TOP_K=${TOP_K:-50}
REP_PENALTY=${REP_PENALTY:-1.05}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.90}               # the card's value; weights are 15 GB, the rest is KV + conv state
MAX_MODEL_LEN=${MAX_MODEL_LEN:-131072}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-8}
MAX_BATCHED_TOKENS=${MAX_BATCHED_TOKENS:-8192}
CUDAGRAPH_MODE=${CUDAGRAPH_MODE:-}
FLASHINFER_AUTOTUNE=${FLASHINFER_AUTOTUNE:-}
BOOT_TIMING=${BOOT_TIMING:-1}
VLLM_BOOT_LOG=${VLLM_BOOT_LOG:-1}                # 1 = append boot stats JSONL to ./storage (mounted by docker_core_args when set)
CACHE_DIR=${CACHE_DIR:-/mnt/noir/scratch/ai/vllm/cache}

# require_image's hint names a plain ./container/build, which would produce the release image.
"${DOCKER[@]}" image inspect "$CONTAINER" >/dev/null 2>&1 || {
  echo "Image $CONTAINER not found. Build the main snapshot first:"
  echo "  VLLM_REF=main ./container/build"; exit 1; }

case "$SPEC_TOKENS" in
  0) ;;
  *[!0-9]*) echo "SPEC_TOKENS must be a number (got '$SPEC_TOKENS')"; exit 1 ;;
  *) echo "## WARNING: SPEC_TOKENS=$SPEC_TOKENS: n-gram speculation on a short-conv hybrid is UNVERIFIED; if the engine refuses at init, use SPEC_TOKENS=0." ;;
esac

docker_core_args
CONTAINER_ARGS+=(
  -e VLLM_SLEEP_WHEN_IDLE=1                                # release SMs when no requests pending (idle power)
  -e HF_HUB_OFFLINE=1                                      # the model is a directory under the read-only /models mount
)
# Startup timing: a PYTHONPATH dir with sitecustomize.py + boot_timing.py (no upstream file replaced).
BOOT_TIMING_DIR="$HERE/../container/patches/boot-timing"
if [[ "$BOOT_TIMING" != "0" ]]; then
  [[ -f "$BOOT_TIMING_DIR/sitecustomize.py" && -f "$BOOT_TIMING_DIR/boot_timing.py" ]] || {
    echo "missing $BOOT_TIMING_DIR/{sitecustomize,boot_timing}.py"; exit 1; }
  CONTAINER_ARGS+=( -v "$BOOT_TIMING_DIR:/opt/boot-timing:ro" -e PYTHONPATH=/opt/boot-timing )
fi
env_extra_args

vllm_core_args
VLLM_ARGS+=(
  --enable-auto-tool-choice
  --reasoning-parser qwen3
  --tool-call-parser lfm2
  --override-generation-config '{ "temperature": '"$TEMPERATURE"', "top_k": '"$TOP_K"', "repetition_penalty": '"$REP_PENALTY"' }'
)
[[ -n "$KV_FP8" && "$KV_FP8" != "0" ]] && VLLM_ARGS+=( --kv-cache-dtype fp8 )
[[ "$SPEC_TOKENS" != "0" ]] && VLLM_ARGS+=( --speculative-config \
  '{"method":"ngram","num_speculative_tokens":'"$SPEC_TOKENS"',"prompt_lookup_max":'"$SPEC_LOOKUP_MAX"',"prompt_lookup_min":'"$SPEC_LOOKUP_MIN"'}' )
nvfp4_backend_args
vllm_extra_args

# Boot-stats JSONL: model name and the resolved serve args, as qwen3.8-flash-next/run does.
CONTAINER_ARGS+=( -e VLLM_MODEL_NAME="$MODEL" )
VLLM_BOOT_ARGS="$(python3 -c '
import json, sys
args = sys.argv[1:]
d = {}
i = 0
while i < len(args):
    a = args[i]
    if a.startswith("--"):
        k = a[2:]
        if "=" in k:
            k, v = k.split("=", 1)
            d[k] = v
        elif i + 1 < len(args) and not args[i + 1].startswith("--"):
            d[k] = args[i + 1]
            i += 1
        else:
            d[k] = True
    i += 1
print(json.dumps(d))
' "${VLLM_ARGS[@]}")"
CONTAINER_ARGS+=( -e VLLM_BOOT_ARGS="$VLLM_BOOT_ARGS" )

echo
echo "## Running $CONTAINER  (lfm2 attn=${ATTN_BACKEND:-auto} moe=${MOE_BACKEND:-auto} ngram=$SPEC_TOKENS kv=$([[ -n $KV_FP8 && $KV_FP8 != 0 ]] && echo fp8 || echo bf16) ctx=$MAX_MODEL_LEN seqs=$MAX_NUM_SEQS gpu0)"
vllm_launch
