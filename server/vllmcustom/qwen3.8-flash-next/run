#!/bin/bash
# Serve Qwen3.8-Flash-Next (180B MoE, 6B active, hybrid GDN + sparse full attention)
# on the ONE RTX PRO 6000, from primitive-ai's mixed NVFP4/FP8 checkpoint.
#
#   ./qwen3.8-flash-next/run                       # primitive-ai/Qwen3.8-Flash-Next-mixed-NVFP4-FP8 (default)
#   ./qwen3.8-flash-next/run <path-or-name>        # another Flash-Next checkpoint under models/vllm
#
# WHY THIS IS NOT ./qwen/run WITH A DIFFERENT DEFAULT
#
# The 180B does not fit a 96 GB card by itself: 51B of its parameters are an n-gram
# embedding table (the "PLE", 95.4 GB in BF16) that vLLM keeps in HOST RAM and
# gathers from on every step through a CPU-offload worker process. That offload
# path is vllm-project/vllm#53899 and, as of 2026-09-06, is still an open PR: the
# architecture itself (Qwen4ExpForConditionalGeneration) merged into main on
# 2026-08-31 (#53896), but only with the table on GPU, i.e. TP2+. Our own image is
# vLLM v0.29.0, which has the architecture but not the offload path (checked
# 2026-09-11 against the v0.29.0 tag: no vllm.v1.ple_offload module, no
# VLLM_PLE_OFFLOAD_* envs, #53899 not in its history). So this launcher runs the
# PR-branch image the
# model card was measured with, vllm/vllm-openai:qwen38-flash-next, NOT the
# locally-built sm120 build every other launcher uses. Revisit once #53899 lands
# in a tagged release: bump VLLM_REF in ./container/build and flip IMAGE back.
#
# UPDATE 2026-09-12: main gained a different single-GPU path on 2026-09-09
# (vllm#54371, pinned host memory + UVA, --engram-config cpu_offload). It is not
# in any tag yet, so this launcher is unchanged; ./qwen3.8-flash-next/run-exp
# serves the same checkpoint from our own image built with VLLM_REF=main.
#
# Three things the model card calls load-bearing on one GPU, all set below:
#   --distributed-executor-backend mp   the default executor never starts the
#                                       offload worker; the server hangs silently
#   VLLM_PLE_OFFLOAD_READY_TIMEOUT      the worker loads the 95 GB table at boot
#   VLLM_GDN_DECODE_KERNEL=triton       REQUIRED by this build's FP8 linear-attention
#                                       projections; the default cuda kernel stalls
#                                       the engine at concurrency ~32 (no error)
# and two more that the field report (discussions/3) found and the card confirmed:
#   --max-num-seqs   the vLLM default (1024) exceeds the Mamba state blocks left
#                    at 0.92 utilization (~598) and CUDA graph capture aborts
#   --max-model-len  with MTP, the native 262144 needs 7.57 GiB of KV and only
#                    5.95 GiB is left after the draft head; 135168 fits, 32768/36
#                    is what every number on the card was measured with
#
# HOST RAM. The table lives in anonymous host memory: ~100 GB free is needed, so
# stop the running model first (this box: 125 GB, no swap). No sysctl is needed
# here -- vm.overcommit_memory=1 is only for hosts where 95 GB > RAM + swap. If
# RAM ever gets tight, the card's alternatives are the INT4 table sidecar (32 GB,
# primitive-ai/Qwen3.8-Flash-Next-PLE-quant, keeps MTP at ~130 tok/s) or the
# NVMe-mapped BF16 table (worker_image_disk.py, ships in the checkpoint; -8%
# single-stream and MTP gains collapse). Neither is wired up here yet.
#
# SPEED (model card, one RTX PRO 6000, 2026-09-03):
#   no speculation        84.4 tok/s @1   526 tok/s @32    570 ms TTFT
#   MTP 3 (default here)  142.6 tok/s @1 (+56%)            table in RAM
#   MOE_BACKEND=marlin     93.2 tok/s @1   ~505 @32        +12% TTFT; MTP OFF only
#   MTP 1 does not boot on this image (engine blocks in shm_broadcast); 2 = 133 tok/s.
#
# Knobs:
#   SPEC_TOKENS=0 ./qwen3.8-flash-next/run         # MTP off (default 3; never 1 -- hangs at boot)
#   SPEC_TOKENS=0 MAX_MODEL_LEN=262144 ...          # native context: only fits WITHOUT the draft head
#   MOE_BACKEND=marlin SPEC_TOKENS=0 ...            # fastest single-stream; refused with MTP on
#                                                   # (draft experts are unquantized BF16; vllm#54788)
#   ATTN_BACKEND=flashinfer ...                     # default EMPTY = let vLLM pick (card config)
#   KV_FP8=1 ...                                    # --kv-cache-dtype fp8 (not on the card; A/B only)
#   VISION=0 ...                                    # --language-model-only (drops the ViT)
#   PATCH_CONNECTOR=0 ...                           # do NOT mount the card's connector_mrv2.py fix
#   PLE_READY_TIMEOUT=3600 ...                      # seconds to wait for the table load (default 1800)
#   MAX_NUM_SEQS=36 MAX_MODEL_LEN=32768 ...         # the card's exact measured config
#   IMAGE_TAG=... IMAGE=... ENV_EXTRA=... EXTRA_ARGS=...   as everywhere else
#   ENV_EXTRA=VLLM_WORKER_MULTIPROC_METHOD=fork ... # the card's docker run does not set spawn;
#                                                   # if boot hangs before the API binds, try this
#
# Benchmark against the running server: ./bench/bench <label>
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=../common/_run-lib.sh
source "$HERE/../common/_run-lib.sh"

# shellcheck disable=SC2034  # read by docker_core_args in common/_run-lib.sh
NAME=vllm
# The PR-branch image, not iphands/vllm-blackwell -- see the header.
IMAGE=${IMAGE:-vllm/vllm-openai}
IMAGE_TAG=${IMAGE_TAG:-qwen38-flash-next}
vllm_image

# shellcheck disable=SC2034  # read by resolve_model in common/_model-lib.sh
DEFAULT_MODEL=primitive-ai/Qwen3.8-Flash-Next-mixed-NVFP4-FP8   # relative to MODEL_ROOT (./models/vllm)
resolve_model "${1:-}"

PORT=${PORT:-8700}
ATTN_BACKEND=${ATTN_BACKEND-}                    # EMPTY = vLLM auto-select (what the card measured)
MOE_BACKEND=${MOE_BACKEND:-}                     # empty = auto (FLASHINFER_CUTLASS on this card); marlin = see SPEED
NVFP4_BACKEND=${NVFP4_BACKEND:-}                 # --linear-backend; the linear layers here are FP8, so leave it
SPEC_TOKENS=${SPEC_TOKENS:-3}                    # MTP speculative tokens; 3 = card optimum; 1 hangs; 0 = off
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}               # card value; the Mamba-block budget above was measured at it
# 131072 is under the 135168 that the field report found fits beside the MTP
# draft head (262144 does not: KV 7.57 GiB vs 5.95 GiB left). SPEC_TOKENS=0
# lifts that ceiling back to the native 262144.
MAX_MODEL_LEN=${MAX_MODEL_LEN:-262144}
# Card pins 36 at 32k; the report ran 64 at 135k. Each sequence reserves GDN
# state up front, so fewer seqs = more KV pool. 16 is twice what ./qwen/run
# found this box's traffic ever needs (4 concurrent agents) and stays well
# inside the ~598-block Mamba budget at 0.92.
MAX_NUM_SEQS=${MAX_NUM_SEQS:-16}
MAX_BATCHED_TOKENS=${MAX_BATCHED_TOKENS:-8192}   # bigger (16384/32768) speeds long-context prefill/TTFT
CUDAGRAPH_MODE=${CUDAGRAPH_MODE:-}               # e.g. FULL_AND_PIECEWISE (A/B)
FLASHINFER_AUTOTUNE=${FLASHINFER_AUTOTUNE:-}     # 1 = FlashInfer autotuning during warmup (A/B)
KV_FP8=${KV_FP8:-}                               # 1 = --kv-cache-dtype fp8 (card runs auto)
VISION=${VISION:-1}                              # 0 = --language-model-only
PATCH_CONNECTOR=${PATCH_CONNECTOR:-1}            # mount connector_mrv2.py over the image's (see below)
PLE_READY_TIMEOUT=${PLE_READY_TIMEOUT:-1800}     # VLLM_PLE_OFFLOAD_READY_TIMEOUT; card: 1800 RAM, 3600 NVMe
CACHE_DIR=${CACHE_DIR:-/mnt/noir/scratch/ai/vllm/cache}

# require_image's hint ("run ./container/build") is wrong for this launcher: the
# image is pulled, not built.
docker image inspect "$CONTAINER" >/dev/null 2>&1 || {
  echo "Image $CONTAINER not found. Pull the model card's PR-branch image first:"
  echo "  docker pull $CONTAINER"; exit 1; }

# Marlin applies to the draft head too, and its experts are unquantized BF16, so
# the engine dies at draft load ("moe_backend='marlin' is not supported for
# unquantized MoE"). The draft-scoped override is ignored by Model Runner V2.
if [[ "$MOE_BACKEND" == marlin && "$SPEC_TOKENS" != "0" ]]; then
  echo "MOE_BACKEND=marlin does not combine with MTP on this image (vllm#54788): set SPEC_TOKENS=0"; exit 1
fi
# num_speculative_tokens: 1 hangs the image at startup, reproduced on three boots.
if [[ "$SPEC_TOKENS" == "1" ]]; then
  echo "SPEC_TOKENS=1 hangs this image at boot (model card); use 2, 3 or 0"; exit 1
fi

# The table is 95.4 GB of anonymous host memory, loaded by the offload worker at
# boot. Warn, don't refuse: the kernel decides, and the number is advisory.
_avail_gb=$(awk '/MemAvailable/ {printf "%d", $2/1048576}' /proc/meminfo)
if (( _avail_gb < 100 )); then
  echo "## WARNING: ${_avail_gb} GB host RAM available; the BF16 n-gram table needs ~100 GB free."
  echo "##          Stop whatever else is running (docker ps) or expect the PLE worker to be OOM-killed."
fi

# Startup-race fix (vllm#53960): the image predates a fix in the offload PR branch
# and can hang right after CUDA graph capture, looping "No available shared memory
# broadcast block found in 60 seconds". The checkpoint ships the fixed connector;
# mounting it over the image's copy is what the card does for every serve command.
CONNECTOR_SRC="$MODEL_ROOT/$MODEL/connector_mrv2.py"
CONNECTOR_DST=/usr/local/lib/python3.12/dist-packages/vllm/v1/ple_offload/connector.py
if [[ "$PATCH_CONNECTOR" != "0" ]]; then
  [[ -f "$CONNECTOR_SRC" ]] || {
    echo "no $CONNECTOR_SRC (download incomplete?) -- use PATCH_CONNECTOR=0 to boot without the fix"; exit 1; }
fi

docker_core_args
CONTAINER_ARGS+=(
  -e VLLM_PLE_CPU_OFFLOAD=1                                # table in host RAM (the single-GPU path)
  -e VLLM_PLE_OFFLOAD_READY_TIMEOUT="$PLE_READY_TIMEOUT"   # 95 GB load at boot; ~300 s warm, longer cold
  -e VLLM_GDN_DECODE_KERNEL=triton                         # REQUIRED for the FP8 GDN projections
  -e VLLM_SLEEP_WHEN_IDLE=1                                # release SMs when no requests pending (idle power)
  # The card's serve command names the HF repo and lets vLLM download it at boot.
  # Ours names a directory under the read-only /models mount, which vLLM loads
  # in place; this makes any Hub access an error rather than a 184 GB surprise.
  -e HF_HUB_OFFLINE=1
)
[[ "$PATCH_CONNECTOR" != "0" ]] && CONTAINER_ARGS+=( -v "$CONNECTOR_SRC:$CONNECTOR_DST:ro" )
env_extra_args

vllm_core_args
VLLM_ARGS+=(
  --distributed-executor-backend mp              # load-bearing: starts the offload worker
  --enable-auto-tool-choice
  --reasoning-parser qwen3
  --tool-call-parser qwen3_coder                 # verified with thinking on, on this exact stack (card)

  # Qwen3.8-Flash-Next README, thinking mode (== the checkpoint's generation_config.json).
  # Instruct / non-thinking set, if ever served with enable_thinking false:
  #   {"temperature": 0.7, "top_p": 0.80, "top_k": 20, "min_p": 0.0, "presence_penalty": 1.5, "repetition_penalty": 1.0}
  --override-generation-config '{ "temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0, "repetition_penalty": 1.0 }'

  --default-chat-template-kwargs '{"enable_thinking": true, "preserve_thinking": true}'
)

[[ -n "$KV_FP8" ]] && VLLM_ARGS+=( --kv-cache-dtype fp8 )
[[ "$VISION" == "0" ]] && VLLM_ARGS+=( --language-model-only )
# SPEC_TOKENS=0 disables MTP entirely (clean no-speculation baseline); else add it.
[[ "$SPEC_TOKENS" != "0" ]] && VLLM_ARGS+=( --speculative-config '{"method":"mtp","num_speculative_tokens":'"$SPEC_TOKENS"'}' )
nvfp4_backend_args
vllm_extra_args

echo
echo "## Running $CONTAINER  (attn=${ATTN_BACKEND:-auto} moe=${MOE_BACKEND:-auto} mtp=$SPEC_TOKENS ctx=$MAX_MODEL_LEN seqs=$MAX_NUM_SEQS gpu0, PLE table in host RAM)"
vllm_launch
