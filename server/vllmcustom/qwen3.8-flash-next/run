#!/bin/bash
# Serve Qwen3.8-Flash-Next (180B MoE, 6B active) on the ONE RTX PRO 6000 from OUR
# sm120 image built from a vLLM main snapshot. The default since 2026-09-13;
# ./qwen3.8-flash-next/run-legacy is the upstream PR-branch image it replaced.
#
#   VLLM_REF=main ./container/build                # build the snapshot first (the VLLM_MAIN_SHA pinned in container/versions.env)
#   ./qwen3.8-flash-next/run                       # primitive-ai/Qwen3.8-Flash-Next-mixed-NVFP4-FP8 (default)
#   ./qwen3.8-flash-next/run <path-or-name>        # another Flash-Next checkpoint under models/vllm
#
# WHY A SEPARATE LAUNCHER FROM run-legacy
#
# ./qwen3.8-flash-next/run-legacy runs vllm/vllm-openai:qwen38-flash-next, the image the
# model card was measured with. That image carries PR vllm#53899: a separate
# CPU-offload WORKER PROCESS that holds the 95.4 GB BF16 n-gram table (the
# "PLE") in host RAM, started only by the mp executor, readied under
# VLLM_PLE_OFFLOAD_READY_TIMEOUT, and patched at runtime with the checkpoint's
# connector_mrv2.py. #53899 never merged. What merged instead, on 2026-09-09, is
# vllm#54371 "[Qwen4Exp] Support UVA PLE-offload and Engram tensor parallelism":
# the table is allocated in PINNED host memory inside the worker and read
# through UVA (a CUDA view of host memory), enabled by
# --engram-config '{"cpu_offload": true}' (the legacy VLLM_PLE_CPU_OFFLOAD=1 env
# was removed in vllm#57937; cpu_offload now defaults to true). Different mechanism, so the three
# PR-branch-only pieces are gone here: no mp executor requirement, no
# READY_TIMEOUT env, no connector mount. Everything below that is not about the
# offload path is copied from ./qwen3.8-flash-next/run-legacy and its model-card notes.
#
# Last verified against main @ a44d7b5 (2026-09-25, VLLM_MAIN_SHA in
# container/versions.env at the time; first verified at 1ee4be4, 2026-09-12, re-checked at
# 468663a, 826e300, 36f94d5 and on each bump): vllm/config/engram.py with
# cpu_offload, Qwen4ExpPLEPinnedHostEmbedding (in qwen4_exp/common/ since
# vllm#57497) selected when it is set, Qwen4ExpForConditionalGeneration +
# Qwen4ExpMTP in the registry, VLLM_GDN_DECODE_KERNEL still an env, the qwen3
# reasoning parser and qwen3_coder tool parser still registered.
#
# FIRST BOOT (2026-09-13): weights loaded (417 s), then the engine died in
# ngram_embedding.py process_weights_after_loading with
#   ValueError: FP8 PLE checkpoint is missing its global scale
# Two things stack up, and this launcher fixes both:
#   1. The checkpoint's config.json declares text_config.ple_embedding_dtype =
#      "float8_e4m3fn" (inherited from the base model) but its table shards are
#      BF16 (ple-bf16-*.safetensors, no weight_scale tensor anywhere). main's
#      from_quant_config() trusts that field first, picks the FP8 method, and
#      then finds no scale. The PR-branch image never read the field. This is
#      checkpoint metadata being wrong, so it is corrected from OUTSIDE the
#      model dir: the launcher reads the real dtype from the first shard's
#      safetensors header and, when it disagrees with config.json, passes
#      --hf-overrides '{"text_config": {"ple_embedding_dtype": "<actual>"}}'.
#      (Nested dicts are merged into the sub-config, not replaced: vLLM's
#      ModelConfig._apply_dict_overrides -> _update_nested.)
#   2. With the field corrected, from_quant_config() sees a compressed-tensors
#      quant config and upstream only knows Fp8Config / ModelOpt there: it would
#      raise NotImplementedError. patches/ple-ct-ignore/ngram_embedding.py is
#      the upstream file plus one branch -- a compressed-tensors `ignore` match
#      on the PLE prefix (this checkpoint: 're:.*\.ple\..*') means unquantized.
#      Mounted over the image's copy (PATCH_PLE=0 to drop it). The overlay is
#      only valid over the exact upstream file it came from, so the launcher
#      hashes the image's copy against BASE_SHA256 in
#      patches/ple-ct-ignore/UPSTREAM before mounting it.
#      Verified in the image: from_quant_config(<this checkpoint's CT config>,
#      <ple prefix>) -> Qwen4ExpPLEUnquantizedEmbeddingMethod.
# SECOND BOOT (2026-09-13): past the PLE method, the pinned-host table itself
# failed to allocate, 3 s into layer construction:
#   ngram_embedding.py allocate_embedding_weight -> torch.empty(..., device="cpu",
#   pin_memory=True) -> torch.AcceleratorError: CUDA error: out of memory
# That is cudaHostAlloc refusing, not the GPU. The whole table is ONE pinned
# tensor (this checkpoint: one PLE layer, 128 shards, 95.4 GiB), and torch's
# pinned-memory caching allocator rounds every request up to the next power of
# two (aten/src/ATen/core/CachingHostAllocator.h: "Round up the allocation to
# the nearest power of two to improve reuse") -- so it asked the driver for
# 128 GiB on a 125 GB box. torch 2.13 has a knob for exactly this:
# pinned_max_round_threshold_mb -- requests above it are not rounded. Measured
# in this image on this box: without it the 95.4 GiB pin fails in 0.2 s with
# the identical error; with pinned_max_round_threshold_mb:1024 it pins in 35 s.
# Set below via PYTORCH_CUDA_ALLOC_CONF (torch reads that name before
# PYTORCH_ALLOC_CONF, and vLLM's own code greps that name). This is also why
# the host needs ~100 GB free rather than ~130: the rounding was the gap.
# Beyond that point: NOT verified. That is what this launcher is for.
#
# What is expected to differ from the PR-branch image, and is deliberately left
# as knobs rather than baked in:
#   - MTP: "num_speculative_tokens 1 hangs at boot" and "marlin + MTP fails at
#     draft load (vllm#54788)" were both observed on the PR-branch image. Neither
#     is refused here; both print a warning so a hang is not a mystery.
#   - MoE backend: the card notes that on early-September nightlies the sm120
#     NVFP4 selector already picks Marlin for the target model, so the default
#     (empty = auto) may land on marlin here where it landed on FLASHINFER_CUTLASS
#     there. Check the "moe_backend" line in the boot log.
#   - Memory: the table is now PINNED (page-locked) host memory, not anonymous.
#     Pinned pages cannot be swapped or reclaimed, and the allocation happens in
#     the engine worker during weight load rather than in a side process, so a
#     shortfall shows up as a CUDA host-alloc error at load, not a worker OOM.
#     --ulimit memlock=-1 (common/_run-lib.sh) is what lets docker pin 95 GB.
#   - The sequence / context ceilings (--max-num-seqs, --max-model-len) were
#     measured on the PR-branch image at gpu-memory-utilization 0.92; the draft
#     head and the KV/Mamba budget are the same weights, so they should carry
#     over, but re-check "Available KV cache memory" and the Mamba block count.
#
# Knobs (same names as ./qwen3.8-flash-next/run-legacy where the meaning is the same):
#   PLE_OFFLOAD=0 ...                              # do NOT offload: table on GPU (TP2+ only; will not fit one card)
#   PATCH_PLE=0 ...                                # do NOT mount patches/ple-ct-ignore (reproduces the NotImplementedError)
#   BOOT_TIMING=0 ...                              # do NOT mount container/patches/boot-timing (startup waterfall report)
#   DRAFT_LOAD_FILTER=0 ...                        # MTP drafter reads the WHOLE checkpoint again (container/patches/draft-load-filter off)
#   PLE_DTYPE=float8_e4m3fn / PLE_DTYPE= ...       # force / skip the ple_embedding_dtype override (default: auto from the shard)
#   PINNED_ROUND_MB=0 ...                          # drop the pinned-allocator knob (reproduces the 128 GiB cudaHostAlloc OOM)
#   GDN_KERNEL=cuda ...                            # VLLM_GDN_DECODE_KERNEL (default triton: REQUIRED by the FP8 GDN projections on the PR image)
#   EXECUTOR=mp ...                                # --distributed-executor-backend (default EMPTY = vLLM's choice; mp was PR-image-only)
#   SPEC_TOKENS=0 ./qwen3.8-flash-next/run         # MTP off (default 3)
#   MOE_BACKEND=marlin ...                         # force it either way (see above)
#   ATTN_BACKEND=flashinfer ...                    # default EMPTY = let vLLM pick
#   KV_FP8=1 ...                                   # --kv-cache-dtype fp8 (A/B only)
#   VISION=0 ...                                   # --language-model-only (drops the ViT)
#   MAX_NUM_SEQS=36 MAX_MODEL_LEN=32768 ...        # the card's exact measured config
#   IMAGE_TAG=cu1321-sm120-main ...                # the MOVING snapshot tag (newest VLLM_REF=main build) instead of the VLLM_MAIN_SHA lookup
#   IMAGE=... ENV_EXTRA=... EXTRA_ARGS=...         # as everywhere else
#
# Benchmark against the running server: ./bench/bench <label>
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=../common/_run-lib.sh
source "$HERE/../common/_run-lib.sh"

# shellcheck disable=SC2034  # read by docker_core_args in common/_run-lib.sh
NAME=vllm
# Our own build, but the SNAPSHOT tag family (VLLM_REF=main ./container/build),
# never :latest -- :latest stays the release build every other launcher uses.
# Pinned to the exact vLLM commit rather than the moving cu<cuda>-sm120-main
# tag, so a later snapshot build cannot change what this launcher runs
# unnoticed: the image is looked up by its ai.vllmcustom.vllm.ref label (stamped
# by container/Dockerfile) against VLLM_MAIN_SHA in container/versions.env --
# the same pin ./container/build builds -- so a bump there is picked up here
# with no edit. The build date in the tag no longer needs to be known. Newest
# match wins (docker lists newest first), restricted to the default CUDA
# variant. IMAGE_TAG=... still overrides.
# shellcheck source-path=SCRIPTDIR source=../container/versions.env
source "$HERE/../container/versions.env"
IMAGE=${IMAGE:-iphands/vllm-blackwell}
if [[ -z ${IMAGE_TAG:-} ]]; then
  IMAGE_TAG=$(docker images "$IMAGE" --filter "label=ai.vllmcustom.vllm.ref=$VLLM_MAIN_SHA" \
                --format '{{.Tag}}' | grep -m1 "^cu${DEFAULT_CUDA_VERSION//./}-sm120-main-vllm" || true)
  if [[ -z $IMAGE_TAG ]]; then
    echo "No $IMAGE image built from vLLM $VLLM_MAIN_SHA (VLLM_MAIN_SHA in container/versions.env)."
    echo "Build the main snapshot first:"
    echo "  VLLM_REF=main ./container/build"; exit 1
  fi
fi
vllm_image

# shellcheck disable=SC2034  # read by resolve_model in common/_model-lib.sh
DEFAULT_MODEL=primitive-ai/Qwen3.8-Flash-Next-mixed-NVFP4-FP8   # relative to MODEL_ROOT (./models/vllm)
resolve_model "${1:-}"

PORT=${PORT:-8700}
ATTN_BACKEND=${ATTN_BACKEND-}                    # EMPTY = vLLM auto-select
MOE_BACKEND=${MOE_BACKEND:-}                     # empty = auto (may already be marlin on main; see header)
NVFP4_BACKEND=${NVFP4_BACKEND:-}                 # --linear-backend; the linear layers here are FP8, so leave it
SPEC_TOKENS=${SPEC_TOKENS:-0}                    # MTP speculative tokens; 3 = card optimum on the PR image; 0 = off
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.955}              # card value; the Mamba-block budget was measured at it
MAX_MODEL_LEN=${MAX_MODEL_LEN:-262144}           # native; the PR image needed <=135168 beside the MTP draft head
MAX_NUM_SEQS=${MAX_NUM_SEQS:-8}                 # see ./qwen3.8-flash-next/run-legacy
MAX_BATCHED_TOKENS=${MAX_BATCHED_TOKENS:-8192}
CUDAGRAPH_MODE=${CUDAGRAPH_MODE:-}               # e.g. FULL_AND_PIECEWISE (A/B)
FLASHINFER_AUTOTUNE=${FLASHINFER_AUTOTUNE:-}     # 1 = FlashInfer autotuning during warmup (A/B)
KV_FP8=${KV_FP8:-}                               # 1 = --kv-cache-dtype fp8
VISION=${VISION:-1}                              # 0 = --language-model-only
PLE_OFFLOAD=${PLE_OFFLOAD:-1}                    # 1 = --engram-config cpu_offload (the single-GPU path)
PATCH_PLE=${PATCH_PLE:-1}                        # mount patches/ple-ct-ignore over the image's ngram_embedding.py (see header)
PLE_DTYPE=${PLE_DTYPE-auto}                      # auto = read the shard; a dtype name = force; EMPTY = trust config.json
PINNED_ROUND_MB=${PINNED_ROUND_MB:-1024}         # pinned requests above this are not rounded to a power of 2; 0 = torch default (see header)
BOOT_TIMING=${BOOT_TIMING:-1}                    # mount container/patches/boot-timing on PYTHONPATH: per-section boot report at "Application startup complete"
DRAFT_LOAD_FILTER=${DRAFT_LOAD_FILTER:-1}        # with MTP: the drafter reads only the 4.9 GiB it keeps, not the 123.5 GiB checkpoint (see below)
GDN_KERNEL=${GDN_KERNEL:-triton}                 # VLLM_GDN_DECODE_KERNEL
EXECUTOR=${EXECUTOR:-}                           # --distributed-executor-backend; empty = default
CACHE_DIR=${CACHE_DIR:-/mnt/noir/scratch/ai/vllm/cache}

# require_image's hint names a plain ./container/build, which would produce the
# release image, not this tag.
docker image inspect "$CONTAINER" >/dev/null 2>&1 || {
  echo "Image $CONTAINER not found. Build the main snapshot first:"
  echo "  VLLM_REF=main ./container/build"; exit 1; }

# PLE patch: an overlay of one upstream file, valid only over the exact upstream
# file it was derived from. Checked by CONTENT: the image's copy must hash to
# BASE_SHA256 in patches/ple-ct-ignore/UPSTREAM. (It used to be checked by vLLM
# commit, which forced an edit on every bump even though the file was
# byte-identical from 468663a to 36f94d5.) Costs one short-lived container, ~1 s.
PATCH_ROOT="$HERE/patches/ple-ct-ignore"
PATCH_SRC="$PATCH_ROOT/ngram_embedding.py"
if [[ "$PATCH_PLE" != "0" ]]; then
  [[ -f "$PATCH_SRC" && -f "$PATCH_ROOT/UPSTREAM" ]] || { echo "missing $PATCH_SRC or $PATCH_ROOT/UPSTREAM"; exit 1; }
  # shellcheck source-path=SCRIPTDIR source=patches/ple-ct-ignore/UPSTREAM
  source "$PATCH_ROOT/UPSTREAM"
  # Where upstream keeps the file moves between commits (nvidia/ -> common/ at
  # vLLM 267eee5), so the mount target comes from UPSTREAM too.
  PATCH_DST=/opt/venv/lib/python3.12/site-packages/$UPSTREAM_PATH
  _img_sum=$(docker run --rm --entrypoint sha256sum "$CONTAINER" "$PATCH_DST" 2>/dev/null | cut -d' ' -f1 || true)
  if [[ "$_img_sum" != "$BASE_SHA256" ]]; then
    _img_ref=$(docker image inspect -f '{{index .Config.Labels "ai.vllmcustom.vllm.ref"}}' "$CONTAINER")
    echo "$CONTAINER (vLLM ${_img_ref:-<no ai.vllmcustom.vllm.ref label>}) ships a different"
    echo "$PATCH_DST than the overlay was derived from (sha256 ${_img_sum:-<unreadable>}, overlay"
    echo "expects $BASE_SHA256 from $BASE_REF). Re-derive the patch (see $PATCH_ROOT/UPSTREAM),"
    echo "or PATCH_PLE=0 to boot without it."; exit 1
  fi
fi

# ple_embedding_dtype: config.json vs. what the shards actually hold. The value
# that matters is the tensor dtype; when config.json disagrees, override it.
# Read from the safetensors header (8-byte length + JSON), no torch needed.
HF_OVERRIDES=
if [[ -n "$PLE_DTYPE" ]]; then
  _ple=$(python3 - "$MODEL_ROOT/$MODEL" "$PLE_DTYPE" <<'PY'
import json, pathlib, struct, sys
m, want = pathlib.Path(sys.argv[1]), sys.argv[2]
cfg = json.load(open(m / "config.json"))
declared = (cfg.get("text_config") or cfg).get("ple_embedding_dtype")
if want == "auto":
    idx = json.load(open(m / "model.safetensors.index.json"))["weight_map"]
    name = next((k for k in sorted(idx) if k.endswith(".ngram_embedding.shard_0.weight")), None)
    if name is None:
        print(f"skip no ngram_embedding.shard_0.weight in the index; declared={declared}"); sys.exit(0)
    with open(m / idx[name], "rb") as f:
        hdr = json.loads(f.read(struct.unpack("<Q", f.read(8))[0]))
    st = hdr[name]["dtype"]
    want = {"BF16": "bfloat16", "F16": "float16", "F32": "float32",
            "F8_E4M3": "float8_e4m3fn"}.get(st, st)
    src = f"{idx[name]} says {st}"
else:
    src = "PLE_DTYPE forced"
if want == declared:
    print(f"ok config.json ple_embedding_dtype={declared} matches ({src})")
else:
    print(f"override {want} config.json says {declared!r}, {src}")
PY
  ) || { echo "PLE dtype check failed"; exit 1; }
  echo "## PLE dtype: ${_ple#* }"
  case "$_ple" in
    override\ *) _dt=${_ple#override }; _dt=${_dt%% *}
                 HF_OVERRIDES='{"text_config": {"ple_embedding_dtype": "'"$_dt"'"}}' ;;
  esac
fi

# Observed on the PR-branch image, unverified on main: warn, don't refuse.
if [[ "$MOE_BACKEND" == marlin && "$SPEC_TOKENS" != "0" ]]; then
  echo "## WARNING: MOE_BACKEND=marlin with MTP failed at draft load on the PR-branch image (vllm#54788: draft experts are BF16)."
  echo "##          If the engine dies with \"moe_backend='marlin' is not supported for unquantized MoE\", set SPEC_TOKENS=0."
fi
if [[ "$SPEC_TOKENS" == "1" ]]; then
  echo "## WARNING: SPEC_TOKENS=1 hung the PR-branch image at boot (engine blocked in shm_broadcast). Watch for a silent stall."
fi

# The table is 95.4 GB of PINNED host memory, allocated in the engine worker
# during weight load. Warn, don't refuse: the kernel decides.
_avail_gb=$(awk '/MemAvailable/ {printf "%d", $2/1048576}' /proc/meminfo)
if (( _avail_gb < 100 )); then
  echo "## WARNING: ${_avail_gb} GB host RAM available; the BF16 n-gram table needs ~100 GB free (pinned, not swappable)."
  echo "##          Stop whatever else is running (docker ps) or expect the host allocation to fail at weight load."
fi

docker_core_args
CONTAINER_ARGS+=(
  -e VLLM_GDN_DECODE_KERNEL="$GDN_KERNEL"                  # triton REQUIRED for the FP8 GDN projections (card)
  -e VLLM_SLEEP_WHEN_IDLE=1                                # release SMs when no requests pending (idle power)
  # The model is a directory under the read-only /models mount, loaded in place;
  # this makes any Hub access an error rather than a 184 GB surprise.
  -e HF_HUB_OFFLINE=1
)
# The 95.4 GiB table is one pinned allocation; stop torch rounding it to 128 GiB.
# If you need other allocator settings, put them in the same variable via
# ENV_EXTRA (last -e wins) and keep this key in it.
[[ "$PINNED_ROUND_MB" != "0" ]] && CONTAINER_ARGS+=( -e PYTORCH_CUDA_ALLOC_CONF="pinned_max_round_threshold_mb:$PINNED_ROUND_MB" )
[[ "$PATCH_PLE" != "0" ]] && CONTAINER_ARGS+=( -v "$PATCH_SRC:$PATCH_DST:ro" )
# Startup timing: a PYTHONPATH dir with sitecustomize.py + boot_timing.py. No
# upstream file is replaced, so there is nothing to sha-check (see its UPSTREAM).
# The image ships no PYTHONPATH; sitecustomize chains Debian's own regardless.
BOOT_TIMING_DIR="$HERE/../container/patches/boot-timing"
if [[ "$BOOT_TIMING" != "0" ]]; then
  [[ -f "$BOOT_TIMING_DIR/sitecustomize.py" && -f "$BOOT_TIMING_DIR/boot_timing.py" ]] || {
    echo "missing $BOOT_TIMING_DIR/{sitecustomize,boot_timing}.py"; exit 1; }
  CONTAINER_ARGS+=( -v "$BOOT_TIMING_DIR:/opt/boot-timing:ro" -e PYTHONPATH=/opt/boot-timing )
fi
# MTP drafter load filter. The drafter (Qwen4ExpMTP) is a second model that
# vLLM loads from the SAME checkpoint, and the default safetensors iterator
# reads every tensor before the drafter's load_weights discards 96% of them:
# 171 s of NFS re-reading on the 2026-09-26 boot (the pinned PLE table leaves
# too little RAM for the page cache to help). draft_load_filter skips, before
# the read, every tensor the drafter's own name-remap would drop -- through
# the same should_skip_weight seam upstream uses for EP expert filtering.
# Like boot-timing it replaces no upstream file (hooks by name, no-ops on
# drift; see its UPSTREAM). Loaded by a NEW .pth in site-packages, so it is
# independent of PYTHONPATH/sitecustomize. Only mounted when MTP is on.
DRAFT_FILTER_DIR="$HERE/../container/patches/draft-load-filter"
if [[ "$DRAFT_LOAD_FILTER" != "0" && "$SPEC_TOKENS" != "0" ]]; then
  [[ -f "$DRAFT_FILTER_DIR/draft_load_filter.py" && -f "$DRAFT_FILTER_DIR/draft_load_filter.pth" ]] || {
    echo "missing $DRAFT_FILTER_DIR/draft_load_filter.{py,pth}"; exit 1; }
  CONTAINER_ARGS+=(
    -v "$DRAFT_FILTER_DIR:/opt/draft-load-filter:ro"
    -v "$DRAFT_FILTER_DIR/draft_load_filter.pth:/opt/venv/lib/python3.12/site-packages/zz_draft_load_filter.pth:ro"
  )
fi
env_extra_args

vllm_core_args
VLLM_ARGS+=(
  --enable-auto-tool-choice
  --reasoning-parser qwen3
  --tool-call-parser qwen3_coder                 # verified with thinking on, on the PR-image stack (card)

  # Qwen3.8-Flash-Next README, thinking mode (== the checkpoint's generation_config.json).
  # Instruct / non-thinking set, if ever served with enable_thinking false:
  #   {"temperature": 0.7, "top_p": 0.80, "top_k": 20, "min_p": 0.0, "presence_penalty": 1.5, "repetition_penalty": 1.0}
  --override-generation-config '{ "temperature": 0.95, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0, "repetition_penalty": 1.0 }'

  --default-chat-template-kwargs '{"enable_thinking": true, "preserve_thinking": true}'
)

# The single-GPU path: table in pinned host RAM, looked up over UVA (vllm#54371).
# Explicit flag even though cpu_offload defaults to true since vllm#57937 (which
# also removed the legacy VLLM_PLE_CPU_OFFLOAD env): the launcher should not
# depend on an upstream default for a 95 GiB placement decision.
[[ "$PLE_OFFLOAD" != "0" ]] && VLLM_ARGS+=( --engram-config '{"cpu_offload": true}' )
[[ -n "$HF_OVERRIDES" ]] && VLLM_ARGS+=( --hf-overrides "$HF_OVERRIDES" )
[[ -n "$EXECUTOR" ]] && VLLM_ARGS+=( --distributed-executor-backend "$EXECUTOR" )
[[ -n "$KV_FP8" ]] && VLLM_ARGS+=( --kv-cache-dtype fp8 )
[[ "$VISION" == "0" ]] && VLLM_ARGS+=( --language-model-only )
# SPEC_TOKENS=0 disables MTP entirely (clean no-speculation baseline); else add it.
[[ "$SPEC_TOKENS" != "0" ]] && VLLM_ARGS+=( --speculative-config '{"method":"mtp","num_speculative_tokens":'"$SPEC_TOKENS"'}' )
nvfp4_backend_args
vllm_extra_args

echo
echo "## Running $CONTAINER  (attn=${ATTN_BACKEND:-auto} moe=${MOE_BACKEND:-auto} mtp=$SPEC_TOKENS draft-filter=$([[ "$DRAFT_LOAD_FILTER" != "0" && "$SPEC_TOKENS" != "0" ]] && echo on || echo off) ctx=$MAX_MODEL_LEN seqs=$MAX_NUM_SEQS gpu0, PLE table pinned in host RAM via --engram-config)"
vllm_launch
