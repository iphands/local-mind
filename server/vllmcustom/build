#!/bin/bash
# Build the sm120-optimized vLLM image from source.
#
#   ./build                       # defaults: CUDA 13.0.3, vLLM v0.27.1 + torch v2.13.0 + flashinfer v0.6.16.post3
#   CUDA_VERSION=13.1.2 ./build   # try a newer CUDA toolkit (produces a different tag)
#   VLLM_REF=v0.25.1 ./build      # try a different vLLM (pin matching TORCH_REF/FLASHINFER_REF too)
#   BUILD_MEM_GB=64 ./build       # tighter memory budget (lowers the derived MAX_JOBS)
#
# Memory: the build is capped at BUILD_MEM_GB (default 110G) two ways — a derived
# MAX_JOBS, plus a kernel-enforced cgroup ceiling if ./scripts/slice-setup has
# been run once as root. See "Memory-capped builds" in the README.
#
# Source trees are cloned/pulled into $BUILD_DIR/src once and reused (no re-clone).
# Patch or `git checkout` them in place; this script only fetches + checks out the pinned ref.
set -euo pipefail

# --- knobs (override via env) ------------------------------------------------
CUDA_VERSION=${CUDA_VERSION:-13.0.3}
TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST:-12.0}      # sm_120 (RTX PRO 6000 Blackwell)
# Memory budget. MAX_JOBS is derived from it because parallel nvcc is what OOMs
# this box (125 GB, no swap): each cicc holds 2-6 GB on the heavy sm120 template
# kernels, so an unbounded 28 jobs can spike past 110 GB. Set MAX_JOBS directly
# to bypass the calculation. ./scripts/slice-setup enforces the same budget as a
# kernel-level backstop; see "Memory-capped builds" in the README.
#
# 110 rather than 90: a full build was measured at a 89.8 GiB peak, i.e. 0.2 GiB
# under a 90 GiB ceiling. Keep this in step with ./scripts/slice-setup — the two
# read the same variable, but the slice has to be re-run to pick up a change.
BUILD_MEM_GB=${BUILD_MEM_GB:-110}
# Measured, not estimated: a complete build peaked at 89.8 GiB with 14 jobs =
# 6.4 GB/job. (An earlier 4.9 GB average came from sampling a light stretch of
# the flashinfer AOT stage; per-kernel demand varies enormously, so an average
# taken at the wrong moment underestimates badly.) 6 is used rather than 7 so the
# derivation reproduces the 14 jobs that build actually ran at; it under-predicts
# the peak by ~7%, which MEM_HEADROOM_PCT below absorbs.
MEM_PER_JOB_GB=${MEM_PER_JOB_GB:-6}
# Jobs are sized against a *fraction* of the budget, not the whole thing. Sizing
# them to BUILD_MEM_GB directly makes predicted peak equal the cap by
# construction (18 x 5 GB = 90 GB = the limit), which parks the build on the
# ceiling permanently. The gap absorbs peak skew — jobs don't all crest at once,
# but a few hitting 7.3 GB together would blow a zero-headroom budget.
# At 110G/6GB/80% this yields 14 jobs: the configuration measured at 89.8 GiB
# peak with oom_kill=0. Raising BUILD_MEM_GB alone would also raise MAX_JOBS and
# spend the new headroom on more jobs — move MEM_PER_JOB_GB with it.
MEM_HEADROOM_PCT=${MEM_HEADROOM_PCT:-80}
_jobs_by_mem=$(( BUILD_MEM_GB * MEM_HEADROOM_PCT / 100 / MEM_PER_JOB_GB ))
_jobs_by_cpu=$(( $(nproc) - 4 ))
MAX_JOBS=${MAX_JOBS:-$(( _jobs_by_mem < _jobs_by_cpu ? _jobs_by_mem : _jobs_by_cpu ))}
# Keep this at 1. `nvcc -t` parallelises across arch targets, so with the single
# 12.0 target in TORCH_CUDA_ARCH_LIST it buys ~nothing -- but vLLM *divides* by
# it: setup.py compute_num_jobs() does `num_jobs = max(1, MAX_JOBS //
# NVCC_THREADS)`. At the old 8 that floored MAX_JOBS=14 to `ninja -j 1`, running
# vllm-build's 404 CUDA targets one at a time at ~3% CPU. torch and flashinfer
# use MAX_JOBS directly, so the damage was confined to (and easy to miss in) the
# last stage.
NVCC_THREADS=${NVCC_THREADS:-1}

# Mutually-compatible default set (vLLM v0.27.1 pins torch 2.13.0 / flashinfer 0.6.16.post3).
VLLM_REF=${VLLM_REF:-v0.27.1}
TORCH_REF=${TORCH_REF:-v2.13.0}
FLASHINFER_REF=${FLASHINFER_REF:-v0.6.16.post3}

# Clean PEP 440 versions (strip leading 'v') baked into the wheels so vLLM's
# torch==X pin resolves to our source build instead of pulling from PyPI.
TORCH_VERSION=${TORCH_VERSION:-${TORCH_REF#v}}
VLLM_VERSION=${VLLM_VERSION:-${VLLM_REF#v}}
FLASHINFER_VERSION=${FLASHINFER_VERSION:-${FLASHINFER_REF#v}}   # prebuilt cubin wheel pin
TORCHVISION_VERSION=${TORCHVISION_VERSION:-0.28.0}
TORCHAUDIO_VERSION=${TORCHAUDIO_VERSION:-2.11.0}      # upstream pairs 2.11.0 with torch 2.13.0

IMAGE=${IMAGE:-iphands/vllm-blackwell}
CUDA_TAG=${CUDA_VERSION//./}                            # 13.0.3 -> 1303
TAG=${TAG:-cu${CUDA_TAG}-sm120}

BUILD_DIR=${BUILD_DIR:-/mnt/noir/scratch/ai/vllm/build}
SRC_DIR="$BUILD_DIR/src"
# -----------------------------------------------------------------------------

here=$(cd "$(dirname "$0")" && pwd)

# Clone-once / fetch-and-checkout helper. $1=name $2=url $3=ref
sync_src() {
  local name=$1 url=$2 ref=$3
  local dir="$SRC_DIR/$name"
  if [[ ! -d "$dir/.git" ]]; then
    echo "## cloning $name ($ref)"
    git clone --recursive "$url" "$dir"
  fi
  echo "## syncing $name -> $ref"
  git -C "$dir" fetch --tags --force origin
  git -C "$dir" checkout --force "$ref"
  git -C "$dir" submodule update --init --recursive --depth 1
}

mkdir -p "$SRC_DIR"
sync_src pytorch    https://github.com/pytorch/pytorch.git        "$TORCH_REF"
sync_src flashinfer https://github.com/flashinfer-ai/flashinfer.git "$FLASHINFER_REF"
sync_src vllm       https://github.com/vllm-project/vllm.git        "$VLLM_REF"

# Fail fast on an incompatible version set. This is host-side only — it never
# runs `docker build`, so it cannot invalidate a layer. Worth the second: a
# flashinfer/vLLM mismatch is otherwise only discovered by the final
# `uv pip install /wheels/*.whl`, after the ~35min AOT recompile.
# PREFLIGHT_ONLY=1 stops here; ALLOW_VERSION_MISMATCH=1 downgrades it to a warning.
echo
SRC_DIR="$SRC_DIR" VLLM_REF="$VLLM_REF" \
TORCH_VERSION="$TORCH_VERSION" FLASHINFER_VERSION="$FLASHINFER_VERSION" \
TORCHVISION_VERSION="$TORCHVISION_VERSION" TORCHAUDIO_VERSION="$TORCHAUDIO_VERSION" \
  "$here/scripts/preflight"
if [[ ${PREFLIGHT_ONLY:-0} == 1 ]]; then
  echo "## PREFLIGHT_ONLY=1 — stopping before docker build."
  exit 0
fi

# Hard memory ceiling for the RUN steps. `docker buildx build` has no --memory
# (classic-builder only); --cgroup-parent is the supported mechanism, and the
# BuildKit embedded in dockerd does honor it (verified: RUN steps land in
# /sys/fs/cgroup/$CGROUP_PARENT/buildkit/).
#
# Read memory.max out of the live cgroup rather than asking systemctl for the
# unit's configured value. BuildKit *creates* the cgroup itself — uncapped — if
# it doesn't exist, so a unit file that was never `systemctl start`ed reports a
# healthy 110G from systemctl while the actual build runs unlimited. The kernel
# state is the only honest answer. Missing/uncapped warns but never fails; the
# derived MAX_JOBS still applies.
#
# Resolve the path via ControlGroup instead of assuming /sys/fs/cgroup/$SLICE:
# systemd reads '-' in a slice name as a hierarchy separator, so vllm-build.slice
# would actually live at /sys/fs/cgroup/vllm.slice/vllm-build.slice. BuildKit
# treats --cgroup-parent as a literal path, so it must get the resolved path
# (leading / stripped) or it would mkdir a fresh uncapped cgroup at the top level.
CGROUP_PARENT=${CGROUP_PARENT:-vllmbuild.slice}
cgroup_args=()
cgroup_path=$(systemctl show "$CGROUP_PARENT" --property=ControlGroup --value 2>/dev/null || true)
live_max=$(cat "/sys/fs/cgroup$cgroup_path/memory.max" 2>/dev/null || true)
if [[ -n $cgroup_path && $live_max =~ ^[0-9]+$ ]]; then
  cgroup_args=(--cgroup-parent="${cgroup_path#/}")
  # The slice does not track BUILD_MEM_GB automatically — slice-setup has to be
  # re-run. Warn on disagreement: a slice capped lower than the budget MAX_JOBS
  # was derived from is how you get an OOM kill from a build that looks correctly
  # sized. Warn only; the cap is real either way and the build is still safe.
  want_max=$(( BUILD_MEM_GB * 1024 * 1024 * 1024 ))
  if [[ $live_max -ne $want_max ]]; then
    echo "## WARN: $CGROUP_PARENT is capped at $(( live_max / 1024 / 1024 / 1024 ))G"
    echo "##       but MAX_JOBS=$MAX_JOBS was derived from BUILD_MEM_GB=${BUILD_MEM_GB}G."
    echo "##       Re-sync:  BUILD_MEM_GB=$BUILD_MEM_GB su -c '$here/scripts/slice-setup'"
  fi
else
  echo "## WARN: $CGROUP_PARENT is missing or uncapped — no hard ceiling on this build."
  echo "##       Install it once:  su -c '$here/scripts/slice-setup'"
  echo "##       Proceeding with MAX_JOBS=$MAX_JOBS as the only limit."
fi

# Build-speed knobs travel as a secret, not --build-arg. BuildKit keeps secret
# contents out of the cache key, so retuning MAX_JOBS reuses the cached compile
# layers instead of forcing a full torch+flashinfer+vllm rebuild (which is what
# ARG/ENV did). Correct as well as convenient: these change build speed, never
# the artifact. The banner below stays the record of what a build actually ran
# with, since the values no longer appear anywhere in the image.
jobs_file=$(mktemp)
trap 'rm -f "$jobs_file"' EXIT
printf 'MAX_JOBS=%s\nNVCC_THREADS=%s\n' "$MAX_JOBS" "$NVCC_THREADS" > "$jobs_file"

echo
echo "## building $IMAGE:$TAG  (cuda=$CUDA_VERSION torch=$TORCH_REF flashinfer=$FLASHINFER_REF vllm=$VLLM_REF arch=$TORCH_CUDA_ARCH_LIST mem=${BUILD_MEM_GB}G jobs=$MAX_JOBS)"

DOCKER_BUILDKIT=1 docker build \
  ${cgroup_args[@]+"${cgroup_args[@]}"} \
  -f "$here/Dockerfile" \
  --build-context pytorch="$SRC_DIR/pytorch" \
  --build-context flashinfer="$SRC_DIR/flashinfer" \
  --build-context vllm="$SRC_DIR/vllm" \
  --build-arg CUDA_VERSION="$CUDA_VERSION" \
  --build-arg TORCH_CUDA_ARCH_LIST="$TORCH_CUDA_ARCH_LIST" \
  --build-arg TORCH_VERSION="$TORCH_VERSION" \
  --build-arg VLLM_VERSION="$VLLM_VERSION" \
  --build-arg FLASHINFER_VERSION="$FLASHINFER_VERSION" \
  --secret id=buildjobs,src="$jobs_file" \
  --build-arg TORCHVISION_VERSION="$TORCHVISION_VERSION" \
  --build-arg TORCHAUDIO_VERSION="$TORCHAUDIO_VERSION" \
  --target vllm-openai \
  -t "$IMAGE:$TAG" \
  -t "$IMAGE:latest" \
  "$here"

echo
echo "## built $IMAGE:$TAG (also tagged :latest)"
