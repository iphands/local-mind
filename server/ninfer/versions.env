# ninfer pins — plain KEY=value only (project gate 1c): `source`d by lib/common.sh and passed to
# `docker build --build-arg`, so no quotes, no spaces, no trailing comments.
# Changing any pin is a plan (context/plans/RULES.md § When Does a Change Need a Plan?).

# NInfer: HEAD of master on 2026-10-27. Artifact contract v3.
NINFER_REPO=https://github.com/Neroued/ninfer.git
NINFER_SHA=64d10fbf9f8e6bfc79ab0570b94674c5b9997929

# CUDA 13.4.3 on Ubuntu 24.04, tag AND manifest-list digest (docker buildx imagetools inspect, 2026-10-27).
CUDA_DEVEL_IMAGE=nvidia/cuda:13.4.3-devel-ubuntu24.04@sha256:5626a7d0ecafe3e7c115a452f6b05f20f214f8509346196a7835b205dc5b7fd9
CUDA_RUNTIME_IMAGE=nvidia/cuda:13.4.3-runtime-ubuntu24.04@sha256:f58bd7a0701fae3a2160f22e1d451b77b349bd9ef83dad76f5529aa413c149a8

# Our image's repository; ./build tags it cu<cuda digits>-sm120a-<sha7>.
IMAGE=iphands/ninfer-blackwell

# The BF16 base the converter needs (Qwen/Qwen3.8-Flash-Next, not gated, 360.0 GB).
HF_BASE_REPO=Qwen/Qwen3.8-Flash-Next
HF_BASE_REV=de4b8e4d43b917e7706784d8bb445c9af86a3540
