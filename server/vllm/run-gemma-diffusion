#!/bin/bash
set -e
NAME=vllm
RUNNER=docker
# [[ -f /usr/bin/podman ]] && RUNNER=podman

MODEL_PATH=$1
MODEL_PATH=$(realpath "$1")
MODEL_FOLDER=${MODEL_PATH%/*}
MODEL=${MODEL_PATH##*vllm/}

echo $MODEL_PATH
echo $MODEL_FOLDER
echo $MODEL


CONTAINER=docker.io/vllm/vllm-openai:latest
# CONTAINER=docker.io/vllm/vllm-openai:cu130-nightly
# CONTAINER=docker.io/vllm/vllm-openai:v0.21.0-cu129-ubuntu2404
# CONTAINER=docker.io/vllm/vllm-openai:cu129-nightly
# CONTAINER=docker.io/iphands/vllm-qwen35-mtp

$RUNNER pull "$CONTAINER"
PORT=8700

CONTAINER_ARGS=(
  run -it --rm
  --name $NAME
  -e VLLM_USE_V2_MODEL_RUNNER=1
  -e UID=1000
  -e GID=1000
  -e APP_UID=1000
  -e APP_GID=1000
  -e CUDA_DEVICE_ORDER=PCI_BUS_ID
  -e NCCL_P2P_LEVEL=4
  -e NCCL_IB_DISABLE=1
  -e VLLM_WORKER_MULTIPROC_METHOD=spawn
  -e SAFETENSORS_FAST_GPU=1
  -p 0.0.0.0:${PORT}:8799
  -v /home/iphands/prog/ai/local-mind/server/vllm/scripts:/myscripts:ro
  -v /mnt/noir/scratch/ai/llm/models/vllm:/models:ro
  -v /mnt/noir/scratch/ai/vllm/cache:/root/.cache:rw
  --ipc=host
  --shm-size=32g
  --ulimit memlock=-1
  --ulimit stack=67108864
  # --entrypoint /bin/bash
)

# Using cache directory: /root/.cache/vllm/torch_compile_cache/27b8d43369/rank_0_0/backbone for vLLM's torch.compile

# /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/configs/README

LLAMA_ARGS=(
  /models/$MODEL
  --served-model-name cosmo-6000 cosmo-proxy claude-heavy claude-light claude-haiku-4-5-20251001
  --host 0.0.0.0
  --port 8799

  --async-scheduling
  # --attention-backend flashinfer
  # --moe-backend flashinfer_trtllm

  --data-parallel-size 1
  # --disable-log-stats
  --dtype auto

  --enable-auto-tool-choice
  # --enable-expert-parallel
  --gpu-memory-utilization 0.90
  # --gpu-memory-utilization 0.85

  # --kv-cache-dtype auto
  --language-model-only
  --max-model-len 262144
  # --max-num-batched-tokens 32768
  # --max-num-seqs 96
  --pipeline-parallel-size 1
  --tensor-parallel-size 1
  --trust-remote-code

  --reasoning-parser qwen3
  --tool-call-parser qwen3_coder
  --enable-prefix-caching
  --enable-chunked-prefill
  --max-num-seqs 3
  --max-num-batched-tokens 8192
  --calculate-kv-scales
  # vllm serve Qwen/Qwen3.5-122B-A10B --port 8000 --tensor-parallel-size 8 --max-model-len 262144 --reasoning-parser qwen3 --speculative-config '{"method":"qwen3_next_mtp","num_speculative_tokens":2}'


  ## Good for Qwen 3.5
  # --speculative-config '{"method":"qwen3_next_mtp","num_speculative_tokens":2}'
  # # --override-generation-config '{ "temperature": 0.6, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0, "repetition_penalty": 1.0 }'
  # --kv-cache-dtype fp8
  # --additional-config '{"turboquant": true, "k_quant": "q8_0", "v_quant": "q5_0"}'

  --attention-backend flashinfer
  --enable-flashinfer
  --no-enforce-eager


  ## 3.6
  # --quantization modelopt # NOTE: Only use this on NVFP4
  # --kv-cache-dtype fp8
  # --override-generation-config '{ "temperature": 0.6, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0, "repetition_penalty": 1.0 }'
  # --speculative-config '{"method":"qwen3_5_mtp","num_speculative_tokens":2}'
  # --default-chat-template-kwargs '{"enable_thinking": true, "preserve_thinking": true}'

  --max-num-seqs 4
  --hf-overrides '{"diffusion_sampler": "entropy_bound", "diffusion_entropy_bound": 0.1}'
  --default-chat-template-kwargs '{"enable_thinking": true}'

  # --additional-config '{"turboquant": true, "k_quant": "q8_0", "v_quant": "q5_0"}'
)

echo
echo "## Running $CONTAINER"

PRE_CMD='
pip install -U transformers &&
echo "Transformers updated"
'

echo "$RUNNER" "${CONTAINER_ARGS[@]}" \
  --entrypoint /bin/bash \
  "$CONTAINER" \
  -lc "$PRE_CMD; exec $(printf '%q ' "${LLAMA_ARGS[@]}")"

"$RUNNER" "${CONTAINER_ARGS[@]}" \
    --entrypoint /bin/bash \
    "$CONTAINER" \
    -lc '
        # pip install -U transformers
        python3 -c "import transformers; print(transformers.__version__)"
        exec "$@"
    ' ls # "${LLAMA_ARGS[@]}"

exit 0
