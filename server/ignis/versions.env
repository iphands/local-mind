# ignis pins — plain KEY=value only (project gate step 3): `source`d by lib/common.sh, so no
# quotes, no spaces, no trailing comments. Changing any pin is a plan
# (context/plans/RULES.md § When Does a Change Need a Plan?).

# The upstream image, release 0.8.0, by tag AND digest (ghcr registry API, 2026-10-27:
# 0.8.0 and latest both resolve to this digest; develop is another one; there is no 0.9.0).
IGNIS_IMAGE=ghcr.io/gpillon/ignis:0.8.0@sha256:83d0ccc3c2dd48280e34e99524626ade0b0fbe5869098fce4be8b45966cdcb6e
IGNIS_VERSION=0.8.0

# Tag v0.8.0 of https://github.com/gpillon/ignis (2026-10-24), the source of that image: every
# flag the launchers pass is cited at this commit (context/distilled.md).
IGNIS_SRC_REF=950ee0d1c2cf6178cd7fec29df3f17c3e127f987

# Weights: the revisions Ignis 0.8.0's own catalog pins (crates/server/src/download/catalog.yaml:18-50
# at IGNIS_SRC_REF). HF HEAD has moved past each one with card/README edits only; the large files
# are byte-identical (HF API, 2026-10-27). None is gated.

# Qwen3.8-Flash-Next, trellis 2.5 bpw + its MTP companion (67.80 GiB, Qwen Community License 1.0).
FN_REPO=gpillon/Qwen3.8-Flash-Next-trellis-a25-ignis
FN_REV=8d94db83cd8e58d6be31e796723e5e35b960638c
FN_ARTIFACT=qwen3_8_flash_next_trellis_a25-v2.ninfer
FN_MTP=qwen3_8_flash_next_mtp_3p0-v2.ninfer

# Qwen3.8-27B, NVFP4 + grafted DFlash2 drafter (18.07 GiB, apache-2.0).
Q27_REPO=gpillon/Qwen3.8-27B-nvfp4full-dflash2-NInfer
Q27_REV=e961b419b672e183aa55df8c4b975abc82006e8a
Q27_ARTIFACT=qwen3_8_27b_nvfp4full-v2.ninfer

# The same 27B with the huihui-ai abliteration (18.07 GiB, apache-2.0; it does not refuse).
Q27A_REPO=gpillon/Qwen3.8-27B-nvfp4full-dflash2-abliterated-NInfer
Q27A_REV=ef3216949e42c42fc713feffb2e05849d57f0f3b
Q27A_ARTIFACT=qwen3_8_27b_nvfp4full-v2-huihui-abliterated.ninfer
